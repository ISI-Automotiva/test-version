	partition dData-ecc0b0ff-96c9-4854-92f4-068bae28db3c = m
		mode: import
		source = ```
				let
				    // Definir o ano de início e o ano atual
				    DataInicio = #date(2025, 1, 1), // Janeiro de 2025
				    DataHoje = DateTime.LocalNow(),  // Data de hoje
				    DataFinal = Date.From(DataHoje), // Converter para data sem hora
				
				    // Criar uma lista de datas entre DataInicio e DataFinal
				    ListaDatas = List.Dates(DataInicio, Duration.Days(DataFinal - DataInicio) + 1, #duration(1, 0, 0, 0)),
				    
				    // Converter a lista de datas para uma tabela
				    TabelaCalendario = Table.FromList(ListaDatas, Splitter.SplitByNothing(), {"Data"}),
				
				    // Adicionar colunas com o ano, mês (nome), semana, ano-mês e ano-semana
				    AdicionarAno = Table.AddColumn(TabelaCalendario, "Ano", each Date.Year([Data]), Int64.Type),
				    AdicionarMes = Table.AddColumn(AdicionarAno, "Mês (Nome)", each Date.ToText([Data], "MMMM"), type text),
				    AdicionarSemana = Table.AddColumn(AdicionarMes, "Semana", each Date.WeekOfYear([Data]), Int64.Type),
				    AdicionarAnoMes = Table.AddColumn(AdicionarSemana, "Ano-Mês", each Date.ToText([Data], "yyyy-MM"), type text),
				    // Ajuste para Ano-Semana, usando um formato correto
				    AdicionarAnoSemana = Table.AddColumn(AdicionarAnoMes, "Ano-Semana", each Text.Combine({Text.From(Date.Year([Data])), "-", Text.PadStart(Text.From(Date.WeekOfYear([Data])), 2, "0")}), type text),
				    #"Tipo Alterado" = Table.TransformColumnTypes(AdicionarAnoSemana,{{"Data", type date}}),
				    Personalizar1 = Table.AddColumn(
				    #"Tipo Alterado",
				    "Dia da Semana",
				    each Date.DayOfWeekName([Data], "pt-BR"),
				    type text
				),
				    #"Linhas Classificadas" = Table.Sort(Personalizar1,{{"Data", Order.Ascending}})
				in
				    #"Linhas Classificadas"
				```

	annotation PBI_NavigationStepName = Navegação

