	partition No_faultUNS+Emille = m
		mode: import
		source = ```
				let
				    Fonte = GoogleBigQuery.Database(),
				    #"data-lake-manufacturing" = Fonte{[Name="data-lake-manufacturing"]}[Data],
				
				    SQL_Query = "
				        /* ------------------------------------------------------------------
				        PARTE 1: Lógica da tabela GOI (Analytics_emille.vw_goi_nofaultcntrl)
				        ------------------------------------------------------------------ */
				        WITH base_goi AS (
				        SELECT
				            shop AS Shop,
				            line AS Line,
				            REGEXP_REPLACE(st, r'[A-Za-z]', '') AS Station,
				            maq AS Machine,
				            tipo AS MachineLabel,
				            CAST(c_good AS STRING) AS C_Good, -- Cast para STRING para alinhar com o JSON da parte 2
				            timestamp AS dateTime,
				            duracao / 1000 AS Fault_duration,
				            iniciotimestamp AS Fault_start,
				            fimtimestamp AS Fault_end
				        FROM `data-lake-manufacturing.Analytics_emille.vw_goi_nofaultcntrl`
				        WHERE shop = 'BiW'
				            AND DATE(timestamp) >= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL 1 WEEK)
				            AND statusfalha <> TRUE
				            AND fimtimestamp IS NOT NULL
				        ),
				
				        m_goi AS (
				        SELECT
				            *,
				            TRIM(Machine) AS machine_trim,
				            UPPER(TRIM(COALESCE(Machine, ''))) AS upper_machine,
				            CASE WHEN TRIM(Machine) = '' OR Machine IS NULL THEN FALSE ELSE TRUE END AS has_machine,
				            REGEXP_CONTAINS(UPPER(COALESCE(Machine,'')), r'R') AS has_r,
				            REGEXP_CONTAINS(UPPER(COALESCE(Machine,'')), r'DL|LD') AS is_dl_ld,
				            NULLIF(REGEXP_INSTR(UPPER(COALESCE(Machine,'')), r'R'), 0) AS pos_r
				        FROM base_goi
				        ),
				
				        m_candidate_goi AS (
				        SELECT
				            *,
				            CASE
				            WHEN NOT has_machine THEN NULL
				            WHEN (NOT has_r) OR is_dl_ld THEN
				                NULLIF(REPLACE(machine_trim, 'ST', ''), '')
				            WHEN pos_r IS NOT NULL THEN
				                NULLIF(
				                REPLACE(
				                    CONCAT(
				                    SUBSTR(upper_machine, 1, pos_r),
				                    REGEXP_REPLACE(SUBSTR(upper_machine, pos_r + 1), r'[^0-9DL]', '')
				                    ),
				                    'ST', ''
				                ), ''
				                )
				            ELSE NULL
				            END AS candidate
				        FROM m_goi
				        ),
				
				        final_goi AS (
				        SELECT
				            Shop,
				            Line,
				            Station,
				            MachineLabel,
				            C_Good,
				            dateTime,
				            Fault_duration,
				            Fault_start,
				            Fault_end,
				            -- Lógica de limpeza de Machine da parte 1
				            CASE
				            WHEN candidate IS NULL THEN CONCAT(Line, Station)
				            WHEN TRIM(candidate) = '' THEN CONCAT(Line, Station)
				            WHEN REGEXP_CONTAINS(candidate, Line) THEN candidate
				            ELSE CONCAT(Line, candidate)
				            END AS Machine,
				            CONCAT(Line, Station) AS LinhaEstacao,
				            TIMESTAMP_TRUNC(dateTime, HOUR) AS DataHora
				        FROM m_candidate_goi
				        ),
				
				        /* ------------------------------------------------------------------
				        PARTE 2: Lógica da tabela PubSub (Analytics_emille.vw_rawpubsubdata)
				        ------------------------------------------------------------------ */
				        base_pubsub AS (
				            SELECT
				                TIMESTAMP_MILLIS(CAST(JSON_VALUE(payload, '$._timestamp') AS INT64)) AS dateTime,
				                JSON_VALUE(payload, '$.Shop')             AS Shop,
				                JSON_VALUE(payload, '$.Line')             AS Line,
				                REPLACE(JSON_VALUE(payload, '$.Station'), 'ST', '') AS Station,
				                JSON_VALUE(payload, '$.Machine')          AS Machine,
				                JSON_VALUE(payload, '$.C_GOOD')           AS C_Good,
				                JSON_VALUE(fault, '$.start')              AS Fault_start,
				                JSON_VALUE(fault, '$.end')                AS Fault_end,
				                CAST(JSON_VALUE(fault, '$.duration') AS FLOAT64) AS Fault_duration
				            FROM `data-lake-manufacturing.Analytics_emille.vw_rawpubsubdata`
				            LEFT JOIN UNNEST(JSON_EXTRACT_ARRAY(payload, '$.Fault_List')) AS fault
				            WHERE DATE(timestamp) >= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL 3 WEEK)
				                AND topic LIKE '%DataProducts/CycleTime%' 
				        ),
				
				        linha_estacao_pubsub AS (
				            SELECT
				                *,
				                CONCAT(Line, Station) AS LinhaEstacao1
				            FROM base_pubsub
				        ),
				
				        tc_ref_pubsub AS (
				            SELECT *, SPLIT(Line, '_')[SAFE_OFFSET(0)] AS LineClean
				            FROM linha_estacao_pubsub
				        ),
				
				        substituida_pubsub AS (
				            SELECT
				                REPLACE(Station, '_Nw', '') AS Station,
				                REPLACE(Machine, '_Nw', '') AS Machine,
				                Shop,
				                C_Good,
				                dateTime,
				                LineClean AS Line,
				                LinhaEstacao1,
				                Fault_start,
				                Fault_end,
				                Fault_duration
				            FROM tc_ref_pubsub
				        ),
				
				        machine_label_pubsub AS (
				            SELECT
				                *,
				                CASE
				                    WHEN Machine = 'ST' OR Machine IS NULL OR Machine = '' THEN 'Station'
				                    ELSE 'Machine'
				                END AS MachineLabel
				            FROM substituida_pubsub
				        ),
				
				        final_pre_pubsub AS (
				            SELECT
				                REPLACE(Station, 'ST', '') AS Station,
				                CASE 
				                    WHEN Machine IS NULL OR Machine = '' OR Machine = 'ST' THEN ''
				                    ELSE CONCAT(Line, IFNULL(REPLACE(Machine, 'ST', ''), ''))
				                END AS Machine,
				                Shop,
				                C_Good,
				                dateTime,
				                Line,
				                LinhaEstacao1,
				                MachineLabel,
				                Fault_start,
				                Fault_end,
				                Fault_duration
				            FROM machine_label_pubsub
				        ),
				
				        filtro_atividade_pubsub AS (
				            SELECT 
				                *,
				                MAX(dateTime) OVER (PARTITION BY Shop, Line, Station, Machine) as ultima_atividade_maquina
				            FROM final_pre_pubsub
				        ),
				
				        final_pubsub AS (
				        SELECT 
				            Shop,
				            Line,
				            Station,
				            MachineLabel,
				            C_Good,
				            -- Sem ajuste de fuso
				            dateTime,
				            Fault_duration,
				            -- Cast para converter String (JSON) para Timestamp, mas sem subtração de horas
				            CAST(Fault_start AS TIMESTAMP) AS Fault_start,
				            CAST(Fault_end AS TIMESTAMP)   AS Fault_end,
				            Machine,
				            LinhaEstacao1 AS LinhaEstacao,
				            -- Truncate na hora cheia sem ajuste de fuso
				            TIMESTAMP_TRUNC(dateTime, HOUR) AS DataHora
				        FROM filtro_atividade_pubsub
				        WHERE ultima_atividade_maquina >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 1 DAY)
				        )
				
				        /* ------------------------------------------------------------------
				        UNION ALL: Juntando os resultados
				        ------------------------------------------------------------------ */
				
				        SELECT 
				            Shop, Line, Station, MachineLabel, C_Good, dateTime, 
				            Fault_duration, Fault_start, Fault_end, Machine, LinhaEstacao, DataHora
				        FROM final_goi
				
				        UNION ALL
				
				        SELECT 
				            Shop, Line, Station, MachineLabel, C_Good, dateTime, 
				            Fault_duration, Fault_start, Fault_end, Machine, LinhaEstacao, DataHora
				        FROM final_pubsub;
				    ",
				    ConsultaNativa = Value.NativeQuery(#"data-lake-manufacturing", SQL_Query),
				    #"Linhas Filtradas" = Table.SelectRows(ConsultaNativa, each ([Fault_duration] <> null)),
				    DuracaoMin = Table.AddColumn(#"Linhas Filtradas", "DuracaoMin", each [Fault_duration] / 60, type number),
				    ClassicacaoParada = Table.AddColumn( 
				    #"DuracaoMin",
				    "ClassificaçãoParada",
				    each if [DuracaoMin] = null then null
				         else if [DuracaoMin] >= 10 then "Quebra"
				         else if [DuracaoMin] <= 0 then null
				         else "Microparada"
				)
				in
				    ClassicacaoParada
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Exception

