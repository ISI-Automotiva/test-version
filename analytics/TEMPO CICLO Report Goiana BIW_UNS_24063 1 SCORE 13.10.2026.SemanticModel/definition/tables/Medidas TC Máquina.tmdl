	measure TC_Máquina_Média_Interquartil = ```
			
			VAR Q1 = [TC_Máquina'Q1]
			VAR Q3 = [TC_Máquina'Q3]
			RETURN
			    CALCULATE(
			        AVERAGE('RT_EventosMáquina'[Cycle_Time]),
			        FILTER(
			            ALL('RT_EventosMáquina'),
			            'RT_EventosMáquina'[Cycle_Time] >= Q1 &&
			            'RT_EventosMáquina'[Cycle_Time] <= Q3
			        )
			    )
			
			```
		formatString: 0
		lineageTag: fd25b66e-3e3c-4d66-8ee8-34508d60f714

		annotation PBI_FormatHint = {"isDecimal":true}

