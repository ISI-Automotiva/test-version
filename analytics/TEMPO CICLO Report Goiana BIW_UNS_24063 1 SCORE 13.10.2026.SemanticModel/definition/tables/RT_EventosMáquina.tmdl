	column Machine
		dataType: string
		lineageTag: dd211340-5d2b-44f5-a44b-2a657035dda2
		summarizeBy: none
		sourceColumn: Machine

		annotation SummarizationSetBy = Automatic

	partition RT_EventosMáquina-28ecd8e2-493c-40fe-8dd9-16249700d074 = m
		mode: import
		source = ```
				let
				    Fonte = GoogleBigQuery.Database(),
				    #"data-lake-manufacturing" = Fonte{[Name="data-lake-manufacturing"]}[Data],
				
				    SQL_Query = "
				WITH 
				-- =============================================================================
				-- BLOCO 1: LÓGICA UNS (Origem: Payload JSON)
				-- =============================================================================
				uns_base AS (
				    SELECT
				        TIMESTAMP_MILLIS(CAST(JSON_VALUE(payload, '$._timestamp') AS INT64)) AS dateTime,
				        JSON_VALUE(payload, '$.Plant')             AS Plant,
				        JSON_VALUE(payload, '$.Shop')             AS Shop,
				        JSON_VALUE(payload, '$.Line')             AS Line,
				        REPLACE(JSON_VALUE(payload, '$.Station'), 'ST', '') AS Station,
				        JSON_VALUE(payload, '$.Machine')          AS Machine,
				        JSON_VALUE(payload, '$.NSEQ')             AS Nseq,
				        JSON_VALUE(payload, '$.CSALD')            AS CSALD,
				        SAFE_CAST(JSON_VALUE(payload, '$.C_GOOD') AS INT64) AS C_Good,
				        CAST(JSON_VALUE(payload, '$.Cycle_Time')       AS FLOAT64) AS Cycle_Time,
				        CAST(JSON_VALUE(payload, '$.Delta_Time_Cycle') AS FLOAT64) AS Delta_Time_Cycle
				    FROM `data-lake-manufacturing.Analytics_emille.vw_rawpubsubdata`
				    WHERE DATE(timestamp) >= DATE_SUB(
				            DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)),INTERVAL 1 MONTH)
				        AND topic LIKE '%DataProducts/CycleTime%' 
				),
				
				uns_linha_estacao AS (
				    SELECT
				        *,
				        CONCAT(Line, Station) AS LinhaEstacao1
				    FROM uns_base
				),
				
				uns_tc_ref AS (
				    SELECT
				        *,
				        CASE
				            WHEN Line LIKE '%SCC%' OR Line LIKE '%SCE%' OR
				                 Line LIKE '%AUC%' OR Line LIKE '%AUE%' OR
				                 Line LIKE '%TEA%' OR Line LIKE '%PPA%' THEN 52
				            WHEN Line LIKE '%OFS%' OR Line LIKE '%OFD%' OR
				                 Line LIKE '%FDA%' OR Line LIKE '%FSA%' OR
				                 Line LIKE '%FPD%' OR Line LIKE '%FPS%' OR
				                 Line LIKE '%PAN%' OR Line LIKE '%SPJ%' OR
				                 Line LIKE '%TUP%' THEN 50
				            WHEN Line LIKE '%PPF%' OR Line LIKE '%PBP%' THEN 89
				            WHEN Line = 'TPF' THEN 56
				            WHEN Line = 'SPO' THEN 66
				            WHEN Line = 'SPG' THEN 69
				            WHEN Line = 'COF' THEN 62
				            ELSE 55
				        END AS TC_Referencia
				    FROM uns_linha_estacao
				),
				
				uns_substituida AS (
				    SELECT
				        REPLACE(Station, '_Nw', '') AS Station,
				        REPLACE(Machine, '_Nw', '') AS Machine,
				        Shop,
				        C_Good,
				        Cycle_Time,
				        Nseq,
				        dateTime,
				        CSALD,
				        SPLIT(Line, '_')[SAFE_OFFSET(0)] AS Line,
				        SPLIT(Line, '_')[SAFE_OFFSET(1)] AS OrigemDados,
				        LinhaEstacao1,
				        TC_Referencia,
				        Delta_Time_Cycle
				    FROM uns_tc_ref
				),
				
				uns_machine_label AS (
				    SELECT
				        *,
				        CASE
				            WHEN Machine = 'ST' OR Machine IS NULL OR Machine = '' THEN 'Station'
				            ELSE 'Machine'
				        END AS MachineLabel
				    FROM uns_substituida
				),
				
				uns_final AS (
				    SELECT
				        REPLACE(Station, 'ST', '') AS Station,
				        -- === ALTERAÇÃO AQUI ===
				        -- Se Machine estiver vazia, nula ou for 'ST', concatena Line e Station.
				        -- Caso contrário, mantém a lógica de concatenar Line e Machine.
				        CASE 
				            WHEN Machine IS NULL OR TRIM(Machine) = '' OR Machine = 'ST' 
				                THEN CONCAT(Line, REPLACE(Station, 'ST', ''))
				            ELSE CONCAT(Line, IFNULL(REPLACE(Machine, 'ST', ''), ''))
				        END AS Machine,
				        -- ======================
				        Shop,
				        C_Good,
				        Cycle_Time,
				        Nseq,
				        dateTime,
				        CSALD,
				        Line,
				        OrigemDados,
				        LinhaEstacao1,
				        TC_Referencia,
				        MachineLabel,
				        Delta_Time_Cycle
				    FROM uns_machine_label
				),
				
				uns_filtro_atividade AS (
				    SELECT 
				        *,
				        MAX(dateTime) OVER (PARTITION BY Shop, Line, Station, Machine) as ultima_atividade_maquina
				    FROM uns_final
				),
				
				-- Resultado final do Bloco UNS
				uns_result_set AS (
				    SELECT 
				        TIMESTAMP_SUB(dateTime, INTERVAL 3 HOUR) AS dateTime,
				        TIMESTAMP_SUB(TIMESTAMP_TRUNC(dateTime, HOUR), INTERVAL 3 HOUR) AS DataHora,
				        Shop,
				        Line,
				        Station,
				        Machine,
				        Nseq,       -- STRING
				        CSALD,      -- STRING
				        C_Good,     -- INT64
				        Cycle_Time,
				        Delta_Time_Cycle,
				        OrigemDados,
				        LinhaEstacao1 AS LinhaEstacao,
				        TC_Referencia,
				        MachineLabel,
				        'UNS' AS origem_consulta
				    FROM uns_filtro_atividade
				    WHERE ultima_atividade_maquina >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 1 DAY)
				),
				
				-- =============================================================================
				-- BLOCO 2: LÓGICA EMILLE (Origem: Tabela GoI)
				-- =============================================================================
				emille_base AS (
				    SELECT
				        maq AS Machine, 
				        st AS Station,
				        shop AS Shop,
				        CAST(c_good AS INT64) AS C_Good,
				        tcdata AS Cycle_Time,
				        nseq AS Nseq,
				        timestamp AS dateTime,
				        csald AS CSALD,
				        REPLACE(line, 'ST', '') AS Line
				    FROM `data-lake-manufacturing.Analytics_emille.vw_goi_tempociclo`
				    WHERE DATE(timestamp) >= DATE_SUB(
				            DATE_TRUNC(CURRENT_DATE(), WEEK(MONDAY)), INTERVAL 1 MONTH
				        )
				      AND csald != 0
				),
				
				emille_tc_ref AS (
				    SELECT *,
				        CASE
				            WHEN Line LIKE '%SCC%' OR Line LIKE '%SCE%' OR 
				                 Line LIKE '%AUC%' OR Line LIKE '%AUE%' OR 
				                 Line LIKE '%TEA%' OR Line LIKE '%PPA%' THEN 52
				            WHEN Line LIKE '%OFS%' OR Line LIKE '%OFD%' OR 
				                 Line LIKE '%FDA%' OR Line LIKE '%FSA%' OR 
				                 Line LIKE '%FPD%' OR Line LIKE '%FPS%' OR 
				                 Line LIKE '%PAN%' OR Line LIKE '%SPJ%' OR 
				                 Line LIKE '%TUP%' THEN 50
				            WHEN Line LIKE '%PPF%' OR Line LIKE '%PBP%' THEN 89
				            WHEN Line = 'TPF' THEN 56
				            WHEN Line = 'SPO' THEN 66
				            WHEN Line = 'SPG' THEN 69
				            WHEN Line = 'COF' THEN 62
				            ELSE 55
				        END AS TC_Referencia
				    FROM emille_base
				),
				
				emille_substituida AS (
				    SELECT
				        REPLACE(REPLACE(Station, '_Nw', ''), 'ST', '') AS Station,
				        REPLACE(Machine, '_Nw', '') AS Machine,
				        Shop,
				        C_Good,
				        Cycle_Time,
				        Nseq,
				        dateTime,
				        CSALD,
				        SPLIT(Line, '_')[SAFE_OFFSET(0)] AS Line,
				        SPLIT(Line, '_')[SAFE_OFFSET(1)] AS OrigemDados,
				        TC_Referencia
				    FROM emille_tc_ref
				),
				
				emille_machine_label AS (
				    SELECT *,
				        CASE 
				            WHEN Machine = 'ST' OR Machine IS NULL OR Machine = '' 
				            THEN 'Station' ELSE 'Machine'
				        END AS MachineLabel
				    FROM emille_substituida
				),
				
				emille_remover_letras AS (
				    SELECT *,
				        CASE
				            WHEN Machine IS NULL OR TRIM(Machine) = '' THEN Machine
				            WHEN NOT REGEXP_CONTAINS(UPPER(Machine), r'(TTB|TT|TR|PC|R|T)')
				                THEN Machine
				            ELSE REGEXP_REPLACE(
				                    UPPER(Machine),
				                    r'^.*(TTB|TT|TR|PC|R|T)',
				                    'R'
				                  )
				        END AS Machine_clean
				    FROM emille_machine_label
				),
				
				emille_unir_line_machine AS (
				    SELECT *,
				        CASE
				            WHEN Machine_clean IS NULL 
				                 OR TRIM(Machine_clean) = '' 
				                 OR UPPER(Machine_clean) = 'ST'
				                THEN CONCAT(Line, Station)
				            WHEN REGEXP_CONTAINS(
				                    UPPER(Machine_clean),
				                    UPPER(CONCAT(Line, Station))
				                  )
				                THEN Machine_clean
				            ELSE CONCAT(Line, Station, Machine_clean)
				        END AS Machine_final
				    FROM emille_remover_letras
				),
				
				emille_final AS (
				    SELECT
				        Station,
				        REGEXP_REPLACE(
				            REGEXP_REPLACE(Machine_final, r'TT|TR', 'R'),
				            r'R$', ''
				        ) AS Machine,
				        Shop,
				        C_Good,
				        Cycle_Time,
				        Nseq,
				        DATETIME_TRUNC(DATETIME(dateTime), HOUR) AS DataHora,
				        dateTime,
				        CSALD,
				        Line,
				        OrigemDados,
				        COALESCE(
				            REGEXP_SUBSTR(CONCAT(Line, Station), r'^(.*)_'),
				                CONCAT(Line, Station)) AS LinhaEstacao,
				       TC_Referencia,
				        MachineLabel
				    FROM emille_unir_line_machine
				),
				
				-- CTEs Auxiliares para o filtro final da Emille (Lógica PubSub)
				emille_cycle_machines AS (
				    SELECT DISTINCT
				        JSON_VALUE(payload, '$.Machine') AS Machine_raw,
				        JSON_VALUE(payload, '$.Line')   AS Line,
				        REPLACE(JSON_VALUE(payload, '$.Station'), 'ST', '') AS Station_raw
				    FROM `data-lake-manufacturing.Analytics_emille.vw_rawpubsubdata`
				    WHERE DATE(timestamp) >= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
				      AND topic LIKE '%DataProducts/CycleTime%'
				),
				
				emille_station_clean AS (
				    SELECT
				        Machine_raw,
				        Line,
				        REGEXP_REPLACE(UPPER(Station_raw), r'ST', '') AS Station
				    FROM emille_cycle_machines
				),
				
				emille_clean_machine AS (
				    SELECT *,
				        CASE
				            WHEN Machine_raw IS NULL OR Machine_raw = '' THEN Machine_raw
				            WHEN NOT REGEXP_CONTAINS(UPPER(Machine_raw), r'R')
				                 OR REGEXP_CONTAINS(UPPER(Machine_raw), r'(DL|LD)')
				            THEN Machine_raw
				            ELSE CONCAT(
				                SUBSTR(UPPER(Machine_raw), 1, REGEXP_INSTR(UPPER(Machine_raw), r'R')),
				                REGEXP_REPLACE(
				                    SUBSTR(UPPER(Machine_raw), REGEXP_INSTR(UPPER(Machine_raw), r'R') + 1),
				                    r'[^0-9DL]',
				                    ''
				                )
				            )
				        END AS Machine_clean
				    FROM emille_station_clean
				),
				
				emille_unified_machine AS (
				    SELECT
				        Line,
				        Station,
				        CASE
				            WHEN REGEXP_CONTAINS(UPPER(Machine_raw), r'ST') THEN CONCAT(Line, Station)
				            WHEN Machine_raw IS NULL OR TRIM(Machine_raw) = '' THEN CONCAT(Line, Station)
				            WHEN REGEXP_CONTAINS(UPPER(Machine_clean), UPPER(Line)) THEN Machine_clean
				            ELSE CONCAT(Line, Machine_clean)
				        END AS Machine
				    FROM emille_clean_machine
				),
				
				-- Resultado final do Bloco Emille
				emille_result_set AS (
				    SELECT 
				        CAST(f.dateTime AS TIMESTAMP) AS dateTime,
				        CAST(f.DataHora AS TIMESTAMP) AS DataHora,
				        f.Shop,
				        f.Line,
				        f.Station,
				        f.Machine,
				        CAST(f.Nseq AS STRING) AS Nseq,
				        CAST(f.CSALD AS STRING) AS CSALD,
				        f.C_Good,
				        CAST(f.Cycle_Time AS FLOAT64) as Cycle_Time,
				        CAST(NULL AS FLOAT64) AS Delta_Time_Cycle,
				        f.OrigemDados,
				        f.LinhaEstacao,
				        CAST(f.TC_Referencia AS FLOAT64) as TC_Referencia,
				        f.MachineLabel,
				        'Emille' as origem_consulta
				    FROM emille_final f
				    LEFT JOIN emille_unified_machine u
				        ON f.Machine = u.Machine
				    WHERE u.Machine IS NULL
				)
				
				-- =============================================================================
				-- UNIÃO FINAL
				-- =============================================================================
				SELECT * FROM uns_result_set
				UNION ALL
				SELECT * FROM emille_result_set
				    ",
				    ConsultaNativa = Value.NativeQuery(#"data-lake-manufacturing", SQL_Query),
				    #"Inconsistencias em TC e DeltaTC HB" = if Table.HasColumns(ConsultaNativa, "Delta_Time_Cycle") then
				    Table.AddColumn(ConsultaNativa, "inconsis", each [Cycle_Time] > [Delta_Time_Cycle])
				  else
				    Fonte,
				    #"Linhas Filtradas" = Table.SelectRows(#"Inconsistencias em TC e DeltaTC HB", each true),
				    #"Coluna DeltaTC" = Table.AddColumn(#"Linhas Filtradas", "DeltaTC", each [Cycle_Time]-[TC_Referencia], Int64.Type),
				    ClassesHistograma = Table.AddColumn(
				    #"Coluna DeltaTC",
				    "ClassesHistograma",
				    each 
				        if [DeltaTC] = null then null
				        else if [DeltaTC] <= -4 then "TC<-4"
				        else if [DeltaTC] = -3 then "TC=-3"
				        else if [DeltaTC] = -2 then "TC=-2"
				        else if [DeltaTC] = -1 then "TC=-1"
				        else if [DeltaTC] = 0 then "TC=0"
				        else if [DeltaTC] = 1 then "TC=+1"
				        else if [DeltaTC] = 2 then "TC=+2"
				        else if [DeltaTC] = 3 then "TC=+3"
				        else if [DeltaTC] = 4 then "TC=+4"
				        else if [DeltaTC] >= 5 then "TC>+5"
				        else null
				),
				    #"Data Inserida" = Table.AddColumn(ClassesHistograma, "Data", each DateTime.Date([dateTime]), type date),
				    #"Time Inserido" = Table.AddColumn(#"Data Inserida", "Time", each DateTime.Time([dateTime]), type time),
				    #"Hora Inserida" = Table.AddColumn(#"Time Inserido", "Hora.1", each Time.Hour([dateTime]), Int64.Type),
				    #"Coluna Turno" = Table.AddColumn(#"Hora Inserida", "Turno", each if [Time] < #time(6, 0, 0) then "00:00:00 às 05:59:59 - 3T" else if [Time] < #time(15, 48, 0) then "06:00:00 às 15:47:59 - 1T" else "15:48:00 às 23:59:59 - 2T"),
				    #"Cria nova colunaCSALD" = Table.TransformColumns(
				        Table.AddColumn(
				            #"Coluna Turno",
				            "CSALD_temp",
				            each
				                if [CSALD] = null then
				                    "Unknown"
				                else if not List.Contains(
				                    {"AUC_Nw", "AUE_Nw", "FDA", "FPD", "FSA", "FPS", "OFS", "OFD", "SCC", "OFS_highbyte", "SCC_highbyte"},
				                    [Line]
				                ) then
				                    if List.Contains({501, 502, 503, 504}, Number.From([CSALD])) then "5"
				                    else if List.Contains({601, 602, 603, 604}, Number.From([CSALD])) then "1"
				                    else if List.Contains({591, 592}, Number.From([CSALD])) then "7"
				                    else if List.Contains({201, 202, 203, 204}, Number.From([CSALD])) then "3"
				                    else Text.From(Number.From([CSALD]))
				                else
				                    Text.From(Number.From([CSALD]))
				        ),
				        {{"CSALD_temp", each _, type text}}
				    ),
				    RemoverCSALD = Table.RemoveColumns(#"Cria nova colunaCSALD", {"CSALD"}),
				    RenomearCSALD = Table.RenameColumns(RemoverCSALD,{{"CSALD_temp", "CSALD"}}),
				    #"Valor Substituído" = Table.ReplaceValue(RenomearCSALD,"ST","",Replacer.ReplaceText,{"LinhaEstacao"}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Valor Substituído","OFS060TR01","OFS060",Replacer.ReplaceText,{"LinhaEstacao"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído2","OFS060R01","OFS060",Replacer.ReplaceText,{"LinhaEstacao"}),
				    Adiciona = Table.AddColumn(
				        #"Valor Substituído1",
				        "Machine_new",
				        each if Text.Contains([Machine], "OFS060R01") and [MachineLabel] = "Station"
				             then "OFS060"
				             else [Machine],
				        type text
				    ),
				    RemoveAntiga = Table.RemoveColumns(Adiciona, {"Machine"}),
				    Renomeia = Table.RenameColumns(RemoveAntiga, {{"Machine_new", "Machine"}})
				in
				    Renomeia
