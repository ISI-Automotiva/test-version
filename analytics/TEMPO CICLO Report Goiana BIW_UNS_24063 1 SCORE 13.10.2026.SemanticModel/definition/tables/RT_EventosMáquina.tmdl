table RT_EventosMáquina
	lineageTag: 04d268e2-20d6-4734-b045-23f5ea3c382a

	measure 'Média Cyclos OK' = ```
			
			AVERAGEX(
			    FILTER(
			        VALUES('RT_EventosMáquina'[ClassificaçãoParada]),
			        ISBLANK('RT_EventosMáquina'[ClassificaçãoParada])
			    ),
			    CALCULATE(AVERAGE('RT_EventosMáquina'[Cycle_Time]))
			)
			
			```
		lineageTag: 9bdfd40e-441c-4384-8a31-f0e803cb5775

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% de Ciclos com Parada' = ```
			
			 VAR Numerador =  COUNTROWS(
			        FILTER(
			            'RT_EventosMáquina',
			            'RT_EventosMáquina'[ClassificaçãoParada] IN {"Quebra", "Microparada"}
			        )
			    )
			VAR Denominador =
			    COUNTROWS('RT_EventosMáquina')
			RETURN
			    DIVIDE( Numerador, Denominador )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1854d8a4-d6c9-458c-9205-7f96e3690587

	measure Denominador = ```
			
			    COUNTROWS('RT_EventosMáquina')
			```
		formatString: 0
		lineageTag: 424ce20d-2c19-4bb4-b265-d4e1d37cf112

	measure PorcentagemOutdated_prot = ```
			
			VAR TotalOutdated =
			    COALESCE(
			        CALCULATE(
			            DISTINCTCOUNT('RT_EventosMáquina'[Machine]),
			            ALLSELECTED('RT_EventosMáquina'[StatusDADOS]),
			            'RT_EventosMáquina'[StatusDADOS] = "Outdated"
			        ),
			        0
			    )
			
			VAR TotalGeral =
			    CALCULATE(
			        DISTINCTCOUNT('RT_EventosMáquina'[Machine]),
			        ALLSELECTED('RT_EventosMáquina'[StatusDADOS])
			    )
			
			RETURN
			    DIVIDE(TotalOutdated, TotalGeral, 0)
			
			    
			```
		lineageTag: dc522a68-74f8-4eb6-b5ac-83b7245568a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TC_Máquina_Média_Interquartil2 = ```
			
			VAR Q1 = [TC_Máquina'Q1]
			VAR Q3 = [TC_Máquina'Q3]
			RETURN
			    CALCULATE(
			        AVERAGE('RT_EventosMáquina'[Cycle_Time]),
			        FILTER(
			            VALUES('RT_EventosMáquina'),
			            'RT_EventosMáquina'[Cycle_Time] >= Q1 &&
			            'RT_EventosMáquina'[Cycle_Time] <= Q3
			        )
			    )
			
			```
		lineageTag: 209c5f81-865b-48ed-b446-ffb97fb6bcb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TC_Moda 2' =
			
			MINX(
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES('RT_EventosMáquina'[Cycle_Time]),
			            "Frequency", CALCULATE(COUNT('RT_EventosMáquina'[Cycle_Time]))
			        ),
			        [Frequency],
			        0
			    ),
			    'RT_EventosMáquina'[Cycle_Time]
			)
		lineageTag: 8fd97307-d29f-4f2e-94cd-e18117ac7283

		annotation PBI_FormatHint = {"isGeneralNumber":true}

