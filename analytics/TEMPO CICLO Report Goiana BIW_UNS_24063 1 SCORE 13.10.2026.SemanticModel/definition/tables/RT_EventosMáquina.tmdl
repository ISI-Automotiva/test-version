	column StatusDADOS = ```
			
			VAR CurrentTimerName = 'RT_EventosMáquina'[Machine]
			
			-- Último registro da máquina
			VAR LatestTimeSlot =
			    CALCULATE(
			        MAX('RT_EventosMáquina'[dateTime]),
			        FILTER(
			            'RT_EventosMáquina',
			            'RT_EventosMáquina'[Machine] = CurrentTimerName
			        )
			    )
			
			-- Data do último refresh
			VAR DashboardRefreshDate = MAX('DataUpdate'[Last Refresh Date Time])
			
			-- Contagem de Cycle_time no mesmo dia
			VAR CountCycleTimeToday =
			    CALCULATE(
			        COUNTROWS('RT_EventosMáquina'),
			        FILTER(
			            'RT_EventosMáquina',
			            'RT_EventosMáquina'[Machine] = CurrentTimerName
			            && FORMAT('RT_EventosMáquina'[dateTime], "YYYYMMDD") = FORMAT(DashboardRefreshDate, "YYYYMMDD")
			        )
			    )
			
			RETURN
			    IF(
			        FORMAT(LatestTimeSlot, "YYYYMMDD") = FORMAT(DashboardRefreshDate, "YYYYMMDD")
			        && CountCycleTimeToday > 5,
			        "Updated",
			        "Outdated"
			    )
			
			
			
			```
		lineageTag: b56321c2-c07d-41ce-9a90-6465ade40f94
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

