	partition dSequenciasHistograma-38277274-864a-4e33-92f3-c2e537fbcc93 = m
		mode: import
		source = ```
				let
				    Fonte = Table.FromRecords({
				        [SequenciaDeltas=1, ClassesHistograma="TC<-4"],
				        [SequenciaDeltas=2, ClassesHistograma="TC=-3"],
				        [SequenciaDeltas=3, ClassesHistograma="TC=-2"],
				        [SequenciaDeltas=4, ClassesHistograma="TC=-1"],
				        [SequenciaDeltas=5, ClassesHistograma="TC=0"],
				        [SequenciaDeltas=6, ClassesHistograma="TC=+1"],
				        [SequenciaDeltas=7, ClassesHistograma="TC=+2"],
				        [SequenciaDeltas=8, ClassesHistograma="TC=+3"],
				        [SequenciaDeltas=9, ClassesHistograma="TC=+4"],
				        [SequenciaDeltas=10, ClassesHistograma="TC>+5"]
				    }),
				    AdicionarClassificacao = Table.AddColumn( 
				        Fonte,
				        "ClassificaçãoCiclos",
				        each if [SequenciaDeltas] <= 5 then "TC OK" else "OVER TC"
				    )
				in
				    AdicionarClassificacao
				```

	annotation PBI_NavigationStepName = Navegação

