	measure 'Media Cycle Time KO Ajustada' = ```
			
			VAR EstacaoAtual = SELECTEDVALUE('RT_EventosMáquina'[LinhaEstacao])
			
			RETURN
			IF(
			    ISINSCOPE('RT_EventosMáquina'[Machine]), 
			    -- NÍVEL 2: Média padrão para o Robô específico
			    CALCULATE(
			        AVERAGE('RT_EventosMáquina'[Cycle_Time]),
			        'RT_EventosMáquina'[DeltaTC] > 0
			    ) + 0,
			    
			    -- NÍVEL 1: Média apenas dos registros onde Machine = Station (Cabeça)
			    CALCULATE(
			        AVERAGE('RT_EventosMáquina'[Cycle_Time]),
			        'RT_EventosMáquina'[DeltaTC] > 0,
			        'RT_EventosMáquina'[Machine] = EstacaoAtual
			    ) + 0
			)
			```
		formatString: 0
		lineageTag: f27d0c77-c8bd-4185-9922-fe8c4185419d

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Ciclos KO por Modelo' = ```
			
			IF(
			    ISINSCOPE('RT_EventosMáquina'[Machine]), 
			    -- Se você descer ao nível de detalhe da máquina
			    COUNTROWS(
			        FILTER(
			            'RT_EventosMáquina',
			            'RT_EventosMáquina'[DeltaTC] > 0
