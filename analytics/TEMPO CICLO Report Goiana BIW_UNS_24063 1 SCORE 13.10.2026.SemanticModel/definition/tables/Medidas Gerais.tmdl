	measure 'Delta 1D M' = ```
			
			VAR _dia = [Dia Score M]
			VAR _hoje = 
			    COALESCE ( 
			        CALCULATE ( 
			            DIVIDE (
			                SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			                COUNTROWS ( 'RT_EventosMáquina' )
			            ),
			            'RT_EventosMáquina'[Data] = _dia,
			            'RT_EventosMáquina'[inconsis] <> "TRUE"
			        ), 
			        0 
			    )
			RETURN 
			    _hoje
			```
		lineageTag: 3ed798fd-e209-48df-9a60-cdd063f52503

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delta 5D M' = ```
			
			VAR _dia = [Dia Score M]
			VAR _rec =
			    COALESCE (
			        CALCULATE (
			            SUMX (
			                VALUES ( 'RT_EventosMáquina'[Data] ),
			                CALCULATE (
			                    DIVIDE (
			                        SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			                        COUNTROWS ( 'RT_EventosMáquina' )
			                    )
			                )
			            ),
			            KEEPFILTERS ( 'RT_EventosMáquina'[Data] > _dia - 5 && 'RT_EventosMáquina'[Data] <= _dia ),
			            'RT_EventosMáquina'[inconsis] <> "TRUE"
			        ), 0 )
			RETURN 
			    DIVIDE ( _rec, 5 )
			```
		lineageTag: 9dc426ec-e19d-40a5-88bb-429c197ce018

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delta 7D1D M' =
			
			VAR _dia = [Dia Score M]
			VAR _hoje =
			    CALCULATE (
			        DIVIDE (
			            SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			            COUNTROWS ( 'RT_EventosMáquina' )
			        ),
			        'RT_EventosMáquina'[Data] = _dia,
			        'RT_EventosMáquina'[inconsis] <> "TRUE"
			    )
			VAR _TabBase =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( 'RT_EventosMáquina'[Data] ),
			            "@ppp",
			                CALCULATE (
			                    DIVIDE (
			                        SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			                        COUNTROWS ( 'RT_EventosMáquina' )
			                    )
			                )
			        ),
			        'RT_EventosMáquina'[Data] >= _dia - 7 && 'RT_EventosMáquina'[Data] <= _dia - 1,
			        'RT_EventosMáquina'[inconsis] <> "TRUE"
			    )
			VAR _DiasBase = COUNTROWS ( _TabBase )
			VAR _Base     = AVERAGEX ( _TabBase, [@ppp] )
			RETURN
			    IF ( ISBLANK ( _hoje ) || _DiasBase < 2, BLANK (), _hoje - _Base )
		lineageTag: db2052ff-6aa8-4db8-8c1f-258192f69177

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delta 21D7D M' =
			
			VAR _dia = [Dia Score M]
			VAR _TabRec =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( 'RT_EventosMáquina'[Data] ),
			            "@ppp",
			                CALCULATE (
			                    DIVIDE (
			                        SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			                        COUNTROWS ( 'RT_EventosMáquina' )
			                    )
			                )
			        ),
			        'RT_EventosMáquina'[Data] >= _dia - 6 && 'RT_EventosMáquina'[Data] <= _dia,
			        'RT_EventosMáquina'[inconsis] <> "TRUE"
			    )
			VAR _TabBase =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            VALUES ( 'RT_EventosMáquina'[Data] ),
			            "@ppp",
			                CALCULATE (
			                    DIVIDE (
			                        SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			                        COUNTROWS ( 'RT_EventosMáquina' )
			                    )
			                )
			        ),
			        'RT_EventosMáquina'[Data] >= _dia - 27 && 'RT_EventosMáquina'[Data] <= _dia - 7,
			        'RT_EventosMáquina'[inconsis] <> "TRUE"
			    )
			VAR _DiasRec  = COUNTROWS ( _TabRec )
			VAR _DiasBase = COUNTROWS ( _TabBase )
			VAR _Rec      = AVERAGEX ( _TabRec, [@ppp] )
			VAR _Base     = AVERAGEX ( _TabBase, [@ppp] )
			RETURN
			    IF ( _DiasRec < 2 || _DiasBase < 2, BLANK (), _Rec - _Base )
		lineageTag: d4102263-f7f4-4afb-8ee3-ada2792abea8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Score TC' =
			
			-- ==============================================================================
			-- 1. LIMITES DE SATURACAO (tetos fixos; calibrar pelo P95 de cada criterio no Python)
			-- ==============================================================================
			VAR _Lim_ExcKO  = 60.0   -- Excesso medio dos ciclos KO sobre TC_Ref (%); calibrar ~P95
			VAR _Lim_QtdKO  = 100.0  -- Proporcao de ciclos KO (%); ja e limitada a 100, sem saturacao artificial
			VAR _Lim_Beta   = 0.05   -- Inclinacao OLS da perda/peca (s/peca por dia)
			VAR _Lim_BetaW  = 0.05   -- Inclinacao WLS, lambda = 0.08 (s/peca por dia)
			VAR _Lim_D7     = 30.0   -- Variacao %: ultimo dia vs media 7D (janela curta, mais ruidosa)
			VAR _Lim_D21    = 20.0   -- Variacao %: ultimos 7D vs media 21D
			VAR _K_Shrink   = 30     -- Encolhimento: qtd_ko / (qtd_ko + K)
			
			-- Escala das medidas percentuais:
			--   100 se a medida retorna fracao (0,12 exibido como 12%)
			--   1   se a medida ja retorna em pontos percentuais (12)
			VAR _EscalaPct  = 100
			
			-- ==============================================================================
			-- 2. CARGA DOS VALORES (medidas da tabela Medidas Gerais)
			-- ==============================================================================
			VAR _QtdKOAbs   = COALESCE([Ciclos KO Ajustado], 0)
			
			-- Media TC KO% e a RAZAO Media KO / TC_Ref (148,6% = 74/50).
			-- Subtrai 1 para obter o EXCESSO (48,6%); aplica shrinkage por volume de KO
			VAR _RazaoKO    = [Media TC KO%]
			VAR _ExcKORaw   = IF(ISBLANK(_RazaoKO), 0, (_RazaoKO - 1) * _EscalaPct)
			VAR _FatorShr   = DIVIDE(_QtdKOAbs, _QtdKOAbs + _K_Shrink, 0)
			VAR _ValExcKO   = _ExcKORaw * _FatorShr
			
			VAR _ValQtdKO   = COALESCE([% de Ciclos KO Ajustada], 0) * _EscalaPct
			VAR _ValBeta    = COALESCE([Beta Normal M], 0)
			VAR _ValBetaW   = COALESCE([Beta Pond M], 0)
			VAR _ValD7      = COALESCE([Delta 7D1D M], 0) * _EscalaPct
			VAR _ValD21     = COALESCE([Delta 21D7D M], 0) * _EscalaPct
			
			-- ==============================================================================
			-- 3. NORMALIZACAO POR TETO FIXO (clip em [0, Lim] / Lim)
			--    Negativo = melhora/estabilidade -> 0 (perda/peca = 0 e o ideal)
			-- ==============================================================================
			VAR _NExcKO = DIVIDE(MIN(MAX(_ValExcKO, 0), _Lim_ExcKO), _Lim_ExcKO, 0)
			VAR _NQtdKO = DIVIDE(MIN(MAX(_ValQtdKO, 0), _Lim_QtdKO), _Lim_QtdKO, 0)
			VAR _NBeta  = DIVIDE(MIN(MAX(_ValBeta,  0), _Lim_Beta),  _Lim_Beta,  0)
			VAR _NBetaW = DIVIDE(MIN(MAX(_ValBetaW, 0), _Lim_BetaW), _Lim_BetaW, 0)
			-- Materialidade: deltas % comparam a estacao com a propria base.
			-- Base perto de zero infla o % (0,01 -> 0,02 s/peca = +100%).
			-- O fator so deixa o delta pesar quando a perda absoluta e relevante.
			VAR _Lim_Mat    = 0.5    -- perda/peca (s) a partir da qual o delta conta inteiro; calibrar ~P75
			VAR _PerdaPeca  = COALESCE([Perda Média por Ciclo (s)], 0)
			VAR _Mat        = DIVIDE(MIN(MAX(_PerdaPeca, 0), _Lim_Mat), _Lim_Mat, 0)
			
			VAR _ND7    = DIVIDE(MIN(MAX(_ValD7,    0), _Lim_D7),    _Lim_D7,    0) * _Mat
			VAR _ND21   = DIVIDE(MIN(MAX(_ValD21,   0), _Lim_D21),   _Lim_D21,   0) * _Mat
			
			-- Nivel da perda/peca (o proprio indicador do quadro: 0 = ideal, > 0 = critico)
			-- Equivale a %KO x excesso KO: premia quem e alto nos DOIS criterios,
			-- o que a soma aditiva do nivel 1 nao captura.
			VAR _Lim_Perda  = 20.0   -- s/peca; calibrar ~P90
			VAR _NPerda = DIVIDE(MIN(MAX(_PerdaPeca, 0), _Lim_Perda), _Lim_Perda, 0)
			
			-- ==============================================================================
			-- 4. PESOS AHP
			-- ==============================================================================
			-- Nivel 1 (somam 1)
			VAR _W1_ExcKO = 0.545   -- Media TC KO
			VAR _W1_QtdKO = 0.273   -- Quantidade KO %
			VAR _W1_Perda = 0.182   -- Perda por TC
			
			-- Nivel 2, dentro de Perda por TC (somam 1): metade nivel, metade tendencia
			VAR _W2_Perda  = 0.50   -- Nivel da perda/peca (cronico)
			VAR _W2_Beta   = 0.10   -- Tendencia estrutural (OLS)
			VAR _W2_BetaW  = 0.15   -- Tendencia recente (WLS)
			VAR _W2_D7     = 0.10   -- Inflexao curta
			VAR _W2_D21    = 0.075  -- Inflexao media
			VAR _W2_IntExp = 0.05   -- Interacao Explosao
			VAR _W2_IntEst = 0.025  -- Interacao Estrutural
			
			-- Interacoes (produto de normalizados, fica em [0,1])
			VAR _IntExplosao   = _NBetaW * _ND7    -- acelerando agora + salto recente
			VAR _IntEstrutural = _NBeta  * _ND21   -- tendencia longa + degrau na semana
			
			VAR _SubPerda =
			      _NPerda        * _W2_Perda
			    + _NBeta         * _W2_Beta
			    + _NBetaW        * _W2_BetaW
			    + _ND7           * _W2_D7
			    + _ND21          * _W2_D21
			    + _IntExplosao   * _W2_IntExp
			    + _IntEstrutural * _W2_IntEst
			
			-- ==============================================================================
			-- 5. SCORE FINAL (0-100 garantido)
			-- ==============================================================================
			VAR _ScoreCalc =
			      _NExcKO   * _W1_ExcKO
			    + _NQtdKO   * _W1_QtdKO
			    + _SubPerda * _W1_Perda
			
			RETURN
			    ROUND(_ScoreCalc * 100, 1)
		lineageTag: 7f3ce538-eeed-4b51-8052-e3c158689c42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Medidas Gerais' = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

