			    -- No nível do Modelo (Gráfico ou Matriz)
			    CALCULATE(
			        COUNTROWS('RT_EventosMáquina'),
			        FILTER(
			            'RT_EventosMáquina',
			            'RT_EventosMáquina'[DeltaTC] > 0 &&
			            'RT_EventosMáquina'[Machine] = 'RT_EventosMáquina'[Station]
