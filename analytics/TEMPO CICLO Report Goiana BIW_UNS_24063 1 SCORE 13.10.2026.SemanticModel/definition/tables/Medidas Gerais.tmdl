	measure 'Nivel de Prioridade' = ```
			
			-- 1. Capturamos a estação atual do contexto do visual (Nível 1)
			VAR EstacaoAtual = SELECTEDVALUE('RT_EventosMáquina'[LinhaEstacao]) 
			
			VAR Numerador = 
			    IF(
			        ISINSCOPE('RT_EventosMáquina'[Machine]),
			        -- NÍVEL 2: Se estivermos vendo o Robô específico
			        [Ciclos KO Ajustado], 
			        
			        -- NÍVEL 1: Se estivermos vendo a Estação, filtra a máquina para bater com a "cabeça"
			        CALCULATE(
			            [Ciclos KO Ajustado], 
			            'RT_EventosMáquina'[Machine] = EstacaoAtual
			        )
			    )
			
			VAR Denominador = 
			    IF(
			        ISINSCOPE('RT_EventosMáquina'[Machine]),
			        -- NÍVEL 2: Ciclos totais do Robô específico
			        COUNTROWS('RT_EventosMáquina'),
			        
			        -- NÍVEL 1: Ciclos totais da Estação (Cabeça) para a estação atual
			        CALCULATE(
			            COUNTROWS('RT_EventosMáquina'),
			            'RT_EventosMáquina'[Machine] = EstacaoAtual
			        )
			    )
			
			-- 2. Calculamos a divisão (o percentual)
			VAR PercKO = DIVIDE(Numerador, Denominador) + 0
			
			-- 3. Avaliamos a prioridade com base no percentual calculado acima
			RETURN
			    SWITCH(
			        TRUE(),
			        PercKO >= 0.75, "P0", -- De 75% para cima
			        PercKO >= 0.50, "P1", -- De 50% até 74,999...%
			        PercKO >= 0.25, "P2", -- De 25% até 49,999...%
			        PercKO >= 0.05, "P3", 
			        "OK" 
			    )
			```
		lineageTag: 1f474a79-bed9-4a93-ab03-ab9b03f3e2c0

	measure 'Beta Normal M' = ```
			
			        VAR _Dias =
			            ADDCOLUMNS (
			                CALCULATETABLE ( VALUES ( 'RT_EventosMáquina'[Data] ), 'RT_EventosMáquina'[inconsis] <> "TRUE" ),
			                "@y", CALCULATE (
			                          DIVIDE (
			                              SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			                              COUNTROWS ( 'RT_EventosMáquina' )
			                          ),
			                          'RT_EventosMáquina'[inconsis] <> "TRUE"
			                      )
			            )
			        VAR _xmin = MINX ( _Dias, INT ( 'RT_EventosMáquina'[Data] ) )
			        VAR _T    = ADDCOLUMNS ( _Dias, "@x", INT ( 'RT_EventosMáquina'[Data] ) - _xmin )
			        VAR _n    = COUNTROWS ( _T )
			        VAR _Sx   = SUMX ( _T, [@x] )
			        VAR _Sxx  = SUMX ( _T, [@x] * [@x] )
			        VAR _Sy   = SUMX ( _T, [@y] )
			        VAR _Sxy  = SUMX ( _T, [@x] * [@y] )
			        VAR _den  = _n * _Sxx - _Sx * _Sx
			        RETURN IF ( _n < 3 || _den = 0, BLANK (), DIVIDE ( _n * _Sxy - _Sx * _Sy, _den ) )
			```
		lineageTag: 5e6245b9-0360-4e81-b2d5-e9cfe4b31032

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Beta Pond M' = ```
			
			        VAR _Lambda = 0.2
			        VAR _Dias =
			            ADDCOLUMNS (
			                CALCULATETABLE ( VALUES ( 'RT_EventosMáquina'[Data] ), 'RT_EventosMáquina'[inconsis] <> "TRUE" ),
			                "@y", CALCULATE (
			                          DIVIDE (
			                              SUMX ( 'RT_EventosMáquina', MAX ( 'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia], 0 ) ),
			                              COUNTROWS ( 'RT_EventosMáquina' )
			                          ),
			                          'RT_EventosMáquina'[inconsis] <> "TRUE"
			                      )
			            )
			        VAR _xmax = MAXX ( _Dias, INT ( 'RT_EventosMáquina'[Data] ) )
			        VAR _T =
			            ADDCOLUMNS (
			                _Dias,
			                "@x", INT ( 'RT_EventosMáquina'[Data] ) - _xmax,
			                "@w", EXP ( - _Lambda * ( _xmax - INT ( 'RT_EventosMáquina'[Data] ) ) )
			            )
			        VAR _n    = COUNTROWS ( _T )
			        VAR _Sw   = SUMX ( _T, [@w] )
			        VAR _Swx  = SUMX ( _T, [@w] * [@x] )
			        VAR _Swxx = SUMX ( _T, [@w] * [@x] * [@x] )
			        VAR _Swy  = SUMX ( _T, [@w] * [@y] )
			        VAR _Swxy = SUMX ( _T, [@w] * [@x] * [@y] )
			        VAR _den  = _Sw * _Swxx - _Swx * _Swx
			        RETURN IF ( _n < 3 || _den = 0, BLANK (), DIVIDE ( _Sw * _Swxy - _Swx * _Swy, _den ) )
			```
		lineageTag: e7d75500-5bd5-42e9-b4b2-b679fe1f3d70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dia Score M' = ```
			
			        COALESCE (
			            SELECTEDVALUE ( 'RT_EventosMáquina'[Data] ),
			            CALCULATE ( MAX ( 'RT_EventosMáquina'[Data] ), ALLSELECTED ( 'RT_EventosMáquina'[Data] ) )
