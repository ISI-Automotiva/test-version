table 'Medidas Gerais'
	lineageTag: 5ec6453a-9e1e-4e6b-9ebf-15db7c678161

	measure 'Tempo Perdido Total (s)' =
			
			VAR Base =
			    ADDCOLUMNS(
			        'RT_EventosMáquina',
			        "Perda",
			            IF(
			                'RT_EventosMáquina'[Cycle_Time] > 'RT_EventosMáquina'[TC_Referencia],
			                'RT_EventosMáquina'[Cycle_Time] - 'RT_EventosMáquina'[TC_Referencia],
			                BLANK()
			            )
			    )
			RETURN
			SUMX(Base, [Perda])
		lineageTag: e1bd268b-dac3-4a2a-831b-29d853bea276

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Acumulada do Tempo Perdido' =
			
			VAR TabelaOrdenada =
			    ADDCOLUMNS(
			        ALLSELECTED(
			            'RT_EventosMáquina'[Station],
			            'RT_EventosMáquina'[Machine],
			            'RT_EventosMáquina'[CSALD]
			        ),
			        "@TempoPerdido", [Tempo Perdido Total (s)]
			    )
			VAR SomaTotal = SUMX(TabelaOrdenada, [@TempoPerdido])
			VAR SomaAcumulada =
			    SUMX(
			        FILTER(
			            TabelaOrdenada,
			            [@TempoPerdido] >=
			                MAXX(
			                    FILTER(TabelaOrdenada,
			                        'RT_EventosMáquina'[Station] = EARLIER('RT_EventosMáquina'[Station]) &&
			                        'RT_EventosMáquina'[Machine] = EARLIER('RT_EventosMáquina'[Machine])
			                    ), [@TempoPerdido]
			                )
			        ),
			        [@TempoPerdido]
			    )
			RETURN DIVIDE(SomaAcumulada, SomaTotal)
		lineageTag: 79f2c6ec-436e-43f7-a610-2591a38d53a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Índice de Desvio %' = ```
			
			DIVIDE(
			    AVERAGE('RT_EventosMáquina'[Cycle_Time]) -
			    AVERAGE('RT_EventosMáquina'[TC_Referencia]),
			    AVERAGE('RT_EventosMáquina'[TC_Referencia])
			)
			
			
			```
		formatString: 0.00
		lineageTag: 50ee44ac-d60c-4f02-bfda-e9e9fe7df90a

	measure '% de Ciclos KO Ajustada' = ```
			
			-- 1. Capturamos a estação atual do contexto do visual (Nível 1)
			VAR EstacaoAtual = SELECTEDVALUE('RT_EventosMáquina'[LinhaEstacao]) 
			-- Nota: Certifique-se de usar a mesma coluna que está no seu visual (LinhaEstacao ou Station)
			
			VAR Numerador = 
			    IF(
			        ISINSCOPE('RT_EventosMáquina'[Machine]),
			        -- NÍVEL 2: Se estivermos vendo o Robô específico
			        [Ciclos KO Ajustado], 
			        
			        -- NÍVEL 1: Se estivermos vendo a Estação, filtra a máquina para bater com a "cabeça"
			        CALCULATE(
			            [Ciclos KO Ajustado], 
			            'RT_EventosMáquina'[Machine] = EstacaoAtual
			        )
			    )
			
			VAR Denominador = 
			    IF(
			        ISINSCOPE('RT_EventosMáquina'[Machine]),
			        -- NÍVEL 2: Ciclos totais do Robô específico
			        COUNTROWS('RT_EventosMáquina'),
			        
			        -- NÍVEL 1: Ciclos totais da Estação (Cabeça) para a estação atual
			        CALCULATE(
			            COUNTROWS('RT_EventosMáquina'),
			            'RT_EventosMáquina'[Machine] = EstacaoAtual
			        )
			    )
			
			RETURN
			    DIVIDE(Numerador, Denominador) + 0
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ddb943c6-c0c1-499f-a026-aec2c0a13b8d

	measure 'Coeficiente de Variação (CV)' =
			
