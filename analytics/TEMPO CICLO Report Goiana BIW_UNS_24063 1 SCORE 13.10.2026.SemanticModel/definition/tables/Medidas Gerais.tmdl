	measure 'Media TC KO%' = ```
			
			VAR EstacaoAtual = SELECTEDVALUE('RT_EventosMáquina'[LinhaEstacao])
			
			-- Busca a média ajustada (que já isola a 'cabeça' no nível 1)
			VAR MedianaAtual = [Media Cycle Time KO Ajustada]
			
			-- Ajustamos a Referência para também olhar apenas para a 'cabeça' no nível 1
			VAR Referencia = 
			    IF(
			        ISINSCOPE('RT_EventosMáquina'[Machine]),
			        AVERAGE('RT_EventosMáquina'[TC_Referencia]),
			        CALCULATE(
			            AVERAGE('RT_EventosMáquina'[TC_Referencia]),
			            'RT_EventosMáquina'[Machine] = EstacaoAtual
			        )
			    )
			
			VAR Resultado = DIVIDE(MedianaAtual, Referencia)
			
			RETURN
			    IF(Resultado < 0, 0, Resultado)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ddef1f44-be1a-43e5-9419-273e48bdb0f1

	measure 'Ciclos KO Ajustado' = ```
			
			VAR EstacaoAtual = SELECTEDVALUE('RT_EventosMáquina'[LinhaEstacao])
			
			RETURN
			IF(
			    ISINSCOPE('RT_EventosMáquina'[Machine]), 
			    -- NÍVEL 2: Se estiver visualizando o Robô, faz o cálculo padrão
			    COUNTROWS(
			        FILTER(
			            'RT_EventosMáquina',
			            'RT_EventosMáquina'[DeltaTC] > 0
			        )
			    ) + 0,
			    
			    -- NÍVEL 1: Se estiver no nível da Estação, filtra a tabela para bater com a "cabeça"
			    CALCULATE(
			        COUNTROWS(FILTER('RT_EventosMáquina', 'RT_EventosMáquina'[DeltaTC] > 0)),
			        'RT_EventosMáquina'[Machine] = EstacaoAtual
			    ) + 0
			)
			```
		formatString: 0
		lineageTag: dadd3546-a182-4c96-a6b8-23f6ad5e65b9

