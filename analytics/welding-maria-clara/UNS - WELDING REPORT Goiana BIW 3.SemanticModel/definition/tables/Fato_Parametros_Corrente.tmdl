	partition Fato_Parametros_Corrente = m
		mode: import
		source = ```
				let
				    SqlString = "
				        WITH RawData AS (
				            SELECT 
				                REGEXP_EXTRACT(Topic, r'^(?:[^/]+/){4}([^/]+)') AS Line, 
				                REPLACE(JSON_EXTRACT_SCALAR(Payload, '$.timerName'), 'WB', 'R') AS timerName,
				                JSON_EXTRACT_SCALAR(Payload, '$.subIndex') AS subindex,
				                CAST(JSON_EXTRACT_SCALAR(Payload, '$.param_ID') AS INT64) AS param_ID,
				                CAST(JSON_EXTRACT_SCALAR(Payload, '$.value') AS FLOAT64) AS value,
				                
				                TIMESTAMP_MILLIS(CAST(JSON_EXTRACT_SCALAR(Payload, '$._timestamp') AS INT64)) AS _timestamp
				                
				            FROM 
				                `data-lake-manufacturing.Analytics_emille.vw_rawpubsubdata`
				            WHERE 
				                TIMESTAMP >= TIMESTAMP(DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH))
				                AND Topic LIKE '%DataProducts%ExtParamValues%'
				        )
				        SELECT 
				            *,
				            CASE 
				                WHEN param_ID = 124 THEN 
				                    CASE 
				                        WHEN value = 0 THEN 'Primário'
				                        WHEN value = 1 THEN 'Secundário'
				                        ELSE NULL
				                    END 
				                ELSE NULL 
				            END AS Corrente
				        FROM RawData
				        QUALIFY ROW_NUMBER() OVER (
				            PARTITION BY timerName, subindex, param_ID 
				            ORDER BY _timestamp DESC
				        ) = 1
				    ",
				    // 1. Conecta ao banco do Google BigQuery
				    BQ = GoogleBigQuery.Database(),
				    
				    // 2. Seleciona o Projeto onde a query será executada
				    Projeto = BQ{[Name="data-lake-manufacturing"]}[Data],
				    
				    // 3. Executa a string SQL diretamente no projeto usando Value.NativeQuery
				    Fonte = Value.NativeQuery(Projeto, SqlString, null, [EnableFolding=true])
				in
				    Fonte
				```

	annotation PBI_NavigationStepName = Navegação

