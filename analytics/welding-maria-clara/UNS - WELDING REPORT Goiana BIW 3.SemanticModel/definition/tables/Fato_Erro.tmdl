table Fato_Erro
	lineageTag: 81493ae9-1ba3-486f-9855-df9e4e80616b

	measure 'Status Bateria Deslig' = ```
			var ontem = MAX(Fato_Erro[Data]) - 1
			
			 return CALCULATE( COUNTROWS(Fato_Erro), FILTER(Fato_Erro, Fato_Erro[error_code]="Bateria descarreg."&& Fato_Erro[Data]=ontem))
			    
			```
		formatString: 0
		lineageTag: 5923927c-48cb-4da8-9ff0-69e6b000675d

	measure Errors2 = ```
			COUNTROWS(FILTER(Fato_Erro, Fato_Erro[isError_txt] = "Erro"))
			    
			```
		formatString: 0
		lineageTag: eb93597c-2349-4b75-8bb1-4f637b880735

	measure Top3_Erros = ```
			
			VAR RankingAtual = 
			    RANKX(
			        ALLSELECTED(Fato_Erro[errorCode1_txt]), 
			        CALCULATE(SUM(Fato_Erro[total_erros])), 
			        , 
			        DESC, 
			        DENSE
			    )
			RETURN 
			    IF(RankingAtual <= 3, CALCULATE(SUM(Fato_Erro[total_erros])))
			```
		formatString: 0
		lineageTag: d03a098f-3d43-4430-b2a3-40d4b2281b13

	measure ErrorSelecionado = ```
			VAR TabelaFiltrada =
			    ADDCOLUMNS(
			        VALUES(Fato_Erro[errorCode1_txt]),
			        "Qtd", CALCULATE(COUNTROWS('Fato_Erro'))
			    )
			VAR QtdeValores = COUNTROWS(TabelaFiltrada)
			
			RETURN
			SWITCH(
			    TRUE(),
			    QtdeValores = 0, BLANK(),
			    QtdeValores = 1, SELECTEDVALUE('Fato_Erro'[errorCode1_txt]),
			    CONCATENATEX(
			        TabelaFiltrada,
			        Fato_Erro[errorCode1_txt] & ": " & [Qtd],
			        ", ",
			        [Qtd],
			        DESC
			    )
			)
			    
			```
		lineageTag: 84ae7de9-391d-4dd0-9984-09c1c0fb6378

	measure TimerNameSelecionado = ```
			
			VAR TabelaFiltrada =
			    ADDCOLUMNS(
			        VALUES('Fato_Erro'[errorCode1_txt]),
			        "Qtd", CALCULATE(SUM('Fato_Erro'[total_erros]))
			    )
			
			VAR QtdeValores = COUNTROWS(FILTER(TabelaFiltrada, [Qtd] > 0))
			
			RETURN
			    SWITCH(
			        TRUE(),
			        QtdeValores = 0, "Nenhum erro encontrado",
			        
			        -- Se houver apenas 1 erro selecionado/existente
			        QtdeValores = 1, 
			            SELECTEDVALUE('Fato_Erro'[errorCode1_txt]) & ": " & 
			            FORMAT(CALCULATE(SUM('Fato_Erro'[total_erros])), "#,##0"),
			
			        -- Se houver vários, concatena todos ordenando pelo total_erros
			        CONCATENATEX(
			            TabelaFiltrada,
			            'Fato_Erro'[errorCode1_txt] & ": " & FORMAT([Qtd], "#,##0"),
			            ", ",
			            [Qtd], 
			            DESC
			        )
			    )
			```
		lineageTag: 919cb9fd-974e-4bb5-b9ab-afb38e23381f

	measure Top3_Erros_Ultimos_5_Dias = ```
			
			// 1. Data máxima baseada no que está filtrado na tela (não blindada)
			VAR MaxData = CALCULATE(MAX(Fato_Erro[Data]), ALLSELECTED(Fato_Erro))
			VAR MinData = MaxData - 4
			VAR DataEixo = MAX(Fato_Erro[Data])
			
			// 2. Ranking que respeita os filtros da tela
			VAR RankingAtual = 
			    RANKX(
			        ALLSELECTED(Fato_Erro[errorCode1_txt]), 
			        CALCULATE(SUM(Fato_Erro[total_erros])), 
			        , 
			        DESC, 
			        DENSE
			    )
			
			// 3. Pega o valor apenas se for Top 3
			VAR ValorTop3 = 
			    IF(RankingAtual <= 3, CALCULATE(SUM(Fato_Erro[total_erros])))
			
			// 4. Retorna o valor APENAS se a data do eixo X estiver nos últimos 5 dias da seleção
			RETURN 
			    IF(
			        DataEixo >= MinData && DataEixo <= MaxData,
			        ValorTop3
			    )
			```
		formatString: 0
		lineageTag: 4198d938-c4cf-4d84-bac3-e13472919f11

