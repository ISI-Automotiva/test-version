	partition Fato_Erro = m
		mode: import
		source = ```
				let
				    Fonte = GoogleBigQuery.Database(),
				    #"data-lake-manufacturing" = Fonte{[Name="data-lake-manufacturing"]}[Data],
				    Analytics_emille_Schema = #"data-lake-manufacturing"{[Name="Analytics_emille",Kind="Schema"]}[Data],
				    tb_Agg_ExtError_RDS_Table = Analytics_emille_Schema{[Name="tb_Agg_ExtError_RDS",Kind="Table"]}[Data],
				
				    // ------------------------------------------------------------------
				    // Duas corrupcoes empilhadas nesta coluna:
				    //
				    // 1) Acentos perdidos na carga: cada caractere virou "??" (dois U+FFFD,
				    //    um por byte UTF-8). Os bytes nao existem mais -- isto reconstroi.
				    //
				    // 2) Um conserto anterior aplicou "h" -> "ha com acento" sem contexto.
				    //    Danificou "fechado" -> "fecháado", "Fehler" -> "Feháler",
				    //    "Schwei" -> "Scháwei", "durch" -> "durchá", "Blech" -> "Blechá".
				    //
				    // As mensagens sao PT, DE e PL misturados, entao regra generica so onde
				    // for comprovadamente segura. "?? ?? o" e sempre "cao" com cedilha e til;
				    // nenhuma palavra alema ou polonesa desta base tem esse padrao.
				    // ------------------------------------------------------------------
				    Ruim = Character.FromNumber(65533),
				    R2 = Ruim & Ruim,          // um acentuado perdido
				    R4 = R2 & R2,              // dois seguidos
				    NH = "~~NAOHA~~",          // marcador temporario, nao existe nos dados
				
				    Trocas = {
				        // -- normaliza o unico "ha" legitimo, venha como vier
				        { "há" & R2,          "há" },
				        { "N" & R2 & "o",     "Não" },
				        { "h" & R2,           "há" },
				        { "Não há",           NH },
				
				        // -- desfaz a injecao cega de acento depois de todo "h"
				        { "há",               "h" },
				        { NH,                 "Não há" },
				
				        // -- acentos perdidos
				        { R4 & "es",          "ções" },
				        { R4 & "o",           "ção" },
				        { "Schwei" & R2,      "Schweiß" },
				        { "Z" & R2 & "ndung", "Zündung" },
				        { "gefr" & R2 & "st", "gefräst" },
				        { "Fr" & R2 & "s",    "Fräs" },
				        { "obw" & R2 & "d",   "obwód" },
				        { "m" & R2 & "x",     "máx" },
				        { "M" & R2 & "x",     "Máx" },
				        { "substitu" & R2 & "do", "substituído" },
				        { "Pot" & R2 & "ncia",    "Potência" },
				        { "Mem" & R2 & "ria",     "Memória" },
				        { "conex" & R2 & "o",     "conexão" },
				        { "1" & R2,           "1ª" },
				        { "2" & R2,           "2ª" }
				    },
				
				    Corrigir = (t as nullable text) as nullable text =>
				        if t = null then null
				        else List.Accumulate(
				                Trocas, t,
				                (estado, par) => Text.Replace(estado, par{0}, par{1})
				             ),
				
				    #"Colunas Renomeadas" = Table.TransformColumns( 
				        Table.RenameColumns(tb_Agg_ExtError_RDS_Table, {{"data", "Data"}}),
				        {
				            {"error_code",     Corrigir, type text},
				            {"errorCode1_txt", Corrigir, type text}
				        }
				    )
				in
				    #"Colunas Renomeadas"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

