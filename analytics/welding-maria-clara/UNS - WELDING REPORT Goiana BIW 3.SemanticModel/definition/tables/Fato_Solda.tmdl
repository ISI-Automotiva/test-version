			        VAR _MaxX = MAXX( _S, INT( Fato_Splash_Diario[Data] ) )
			        VAR _MinY = MINX( _S, Fato_Splash_Diario[splash_dia] )
			        VAR _MaxY = MAXX( _S, Fato_Splash_Diario[splash_dia] )
			        VAR _N = ADDCOLUMNS( _S,
			                "W",  EXP( -0.17 * ( _Fim - Fato_Splash_Diario[Data] ) ),
			                "Xn", DIVIDE( INT( Fato_Splash_Diario[Data] ) - _MinX, _MaxX - _MinX ),
			                "Yn", DIVIDE( Fato_Splash_Diario[splash_dia] - _MinY, _MaxY - _MinY ) )
			        VAR _sw = SUMX( _N, [W] )
			        VAR _mx = DIVIDE( SUMX( _N, [Xn] * [W] ), _sw )
			        VAR _my = DIVIDE( SUMX( _N, [Yn] * [W] ), _sw )
			        VAR _D  = ADDCOLUMNS( _N, "dx", [Xn] - _mx, "dy", [Yn] - _my )
			        VAR _cov = SUMX( _D, [W] * [dx] * [dy] )
			        VAR _var = SUMX( _D, [W] * [dx] * [dx] )
			        RETURN IF( _var = 0, BLANK(), DEGREES( ATAN( DIVIDE( _cov, _var ) ) ) )
			```
		lineageTag: fc9e9c92-fd20-4647-be99-beafb1889582

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Erros_Ultimos_5_Dias =
			
			VAR MaxData =
			    MAX(Fato_Erro[Data])
			
			VAR DataInicial =
			    MaxData - 4
			
			RETURN
			    CALCULATE(
			        COUNT(Fato_Erro[errorCode1_txt]),
			        KEEPFILTERS( Fato_Erro[Data] >= DataInicial ),
			        KEEPFILTERS( Fato_Erro[Data] <= MaxData )
			    )
		formatString: 0
		lineageTag: 086923a6-11ea-4f6e-aec3-2ec4078b5c51

	/// Quantidade de PINCAS (electrodeNo) com PSQ ligado. Classifica pelo status do ULTIMO DIA com dado dentro dos filtros vigentes, conforme regra definida em 14/10/2026. Empate no mesmo dia (linhas ligada e desligada na mesma data) resolve para Desligado, por MINX sobre texto -- critario conservador de cobertura; trocar por MAXX inverte. NAO usa ALL/ALLSELECTED/REMOVEFILTERS: o recorte do usuario vale integralmente, e o ultimo dia e o ultimo dia DO RECORTE.
	measure 'Pinças PSQ Ligado' =
			COUNTROWS (
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( 'Fato_Solda'[electrodeNo] ),
			            "@StatusUltDia",
			                MINX (
			                    TOPN (
			                        1,
			                        SUMMARIZE (
			                                'Fato_Solda',
			                                'Fato_Solda'[Data],
			                                'Fato_Solda'[Status_Measuring]
			                            ),
			                        'Fato_Solda'[Data], DESC
			                    ),
			                    'Fato_Solda'[Status_Measuring]
			                )
			        ),
			        [@StatusUltDia] = "Ligado"
			    )
			)
		formatString: 0
		displayFolder: PSQ
		lineageTag: 2eafca39-80d4-4762-80c2-2861d789b46b

