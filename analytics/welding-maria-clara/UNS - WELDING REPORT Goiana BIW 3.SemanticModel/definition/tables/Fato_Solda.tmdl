	measure Score =
			
			VAR _BL = [Baseline pha2]
			VAR _Limit_B1N  = 80.0     -- graus
			VAR _Limit_BL1D = 0.33     -- FRACAO (= 33%). A medida devolve fracao, sem *100.
			VAR _Limit_BL1M = 0.33     -- FRACAO (= 33%). Nao escrever 33.0 aqui.
			VAR _Limit_B1   = 40.0     -- graus
			
			VAR _Val_B1N  = COALESCE( [β1 pha2_norm], 0 )
			VAR _Val_BL1D = COALESCE( [Δ BL|1D pha2], 0 )
			VAR _Val_BL1M = COALESCE( [Δ BL|1M pha2], 0 )
			VAR _Val_B1   = COALESCE( [β1 pha2], 0 )
			
			VAR _Norm_B1N  = DIVIDE( IF(_Val_B1N <0,0,IF(_Val_B1N >_Limit_B1N, _Limit_B1N, _Val_B1N )), _Limit_B1N  )
			VAR _Norm_BL1D = DIVIDE( IF(_Val_BL1D<0,0,IF(_Val_BL1D>_Limit_BL1D,_Limit_BL1D,_Val_BL1D)), _Limit_BL1D )
			VAR _Norm_BL1M = DIVIDE( IF(_Val_BL1M<0,0,IF(_Val_BL1M>_Limit_BL1M,_Limit_BL1M,_Val_BL1M)), _Limit_BL1M )
			VAR _Norm_B1   = DIVIDE( IF(_Val_B1  <0,0,IF(_Val_B1  >_Limit_B1,  _Limit_B1,  _Val_B1  )), _Limit_B1   )
			
			VAR _T = 22
			VAR _Score =
			      ( _Norm_B1N  * DIVIDE( 9, _T ) )                 -- velocidade recente (λ=0,17/dia)   0,3500
			    + ( _Norm_BL1D * DIVIDE( 4, _T ) )                 -- nivel do dia vs baseline          0,2000
			    + ( _Norm_BL1M * DIVIDE( 3, _T ) )                 -- nivel do mes vs baseline          0,1500
			    + ( _Norm_B1   * DIVIDE( 2, _T ) )                 -- velocidade longa (tendencia)      0,1000
			    + ( _Norm_B1N  * _Norm_BL1D * DIVIDE( 3, _T ) )    -- interacao: rapido E alto hoje     0,1500
			    + ( _Norm_B1   * _Norm_BL1M * DIVIDE( 1, _T ) )    -- interacao: subindo E alto no mes  0,0500
			RETURN
			    IF( ISBLANK( _BL ), BLANK(),
			        ROUND( _Score * 100, 1 ) )                     -- soma das fracoes = 1 -> teto 100
		lineageTag: c18b4c98-8fa3-40be-9190-9d5e5dbfcd8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

