	measure 'Pts Aceleração (Foco)' =
			-- Trava a conta no [Robô em Foco], como fazia [Pts Componente] antes de
			-- ScoreSplash_Componentes ser removida. Componente 1 de 6 da tela 3.3.
			VAR _robo = [Robô em Foco]
			RETURN
			    CALCULATE (
			        [Pts Aceleração],
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
