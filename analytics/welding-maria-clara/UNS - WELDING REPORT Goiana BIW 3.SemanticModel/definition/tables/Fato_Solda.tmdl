	column SP_TRATADO = ```
			
			IF(
			    RIGHT([spotName], 1) = "0",
			    SWITCH(
			        TRUE(),
			        RIGHT([Line], 3) = "X6H",
			            CONCATENATE([spotName], "3"),
			        RIGHT([Line], 3) = "X1H",
			            CONCATENATE([spotName], "2"),
			        //RIGHT([Line], 3) = "376",
			        //    CONCATENATE([Spot_Name], "7"),
			        [spotName]
			    ),
			    IF(
			        RIGHT([spotName], 1) <> "+",
			        IF(
			            LEFT(RIGHT([spotName], 2), 1) = "_",
			            LEFT([spotName], 11) & "0" & RIGHT([spotName], 1),
			            [spotName]
			        ),
			        SWITCH(
			            TRUE(),
			            LEFT(RIGHT([spotName], 5), 1) = "_",
			                   LEFT([spotName], 11) & "0" & RIGHT([spotName], 4),
			            RIGHT([Line], 3) = "X6H",
			                LEFT([spotName], 12) & "3 Q+",
			            RIGHT([Line], 3) = "X1H",
			                LEFT([spotName], 12) & "2 Q+",
			            //RIGHT([Line], 3) = "376",
			            //    LEFT([spotName], 11) & "07 Q+",
			            [spotName]
			        )
			    )
			)
			
			```
