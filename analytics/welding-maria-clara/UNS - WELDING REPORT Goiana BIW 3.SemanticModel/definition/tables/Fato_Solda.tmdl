	measure 'β1 splash_norm' = ```
			
			        VAR _Pinca = SELECTEDVALUE( Fato_Solda[electrodeNo] )
			        VAR _Fim   = MAX( Fato_Solda[Data] )
			        VAR _Ini   = _Fim - 364
			        VAR _S = FILTER(
			                     CALCULATETABLE( Fato_Splash_Diario,
			                         REMOVEFILTERS( Fato_Splash_Diario[electrodeNo] ),
			                         Fato_Splash_Diario[electrodeNo] = _Pinca ),
