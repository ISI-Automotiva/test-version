	/// Distancia ao baseline, no molde de [Δ BL|1D pha2]. No pha2 o baseline e a media do decil inferior do proprio robo e a distancia e RELATIVA, DIVIDE(atual - base, base). No splash o baseline e ZERO: toda splash e defeito, nao existe nivel saudavel proprio de cada robo. Como DIVIDE(x, 0) devolve BLANK, a distancia degenera no proprio nivel (atual - 0 = atual), e a medida passa a ser TAXA ABSOLUTA de splash, nao variacao relativa. Pelo mesmo motivo caiu a clausula '_Base <= 0 -> BLANK' do original: com BL fixo em zero ela seria sempre verdadeira e a medida nunca devolveria valor. Mantem o gate de atraso > 30 dias do original.
	measure 'Δ BL|1D splash' = ```
			
			        VAR _BL  = [Baseline splash]
			        VAR _Dia =
			            DIVIDE( SUM( Fato_Solda[count_Tem_Splash] ), SUM( Fato_Solda[row_count] ) )
			        RETURN
			            IF( ISBLANK( _Dia ), BLANK(), _Dia - _BL )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Score Splash
		lineageTag: 4026abf6-9081-4e3d-9305-af40325735c4

	/// Distancia ao baseline, no molde de [Δ BL|1M pha2]. No pha2 o baseline e a media do decil inferior do proprio robo e a distancia e RELATIVA, DIVIDE(atual - base, base). No splash o baseline e ZERO: toda splash e defeito, nao existe nivel saudavel proprio de cada robo. Como DIVIDE(x, 0) devolve BLANK, a distancia degenera no proprio nivel (atual - 0 = atual), e a medida passa a ser TAXA ABSOLUTA de splash, nao variacao relativa. Pelo mesmo motivo caiu a clausula '_Base <= 0 -> BLANK' do original: com BL fixo em zero ela seria sempre verdadeira e a medida nunca devolveria valor. Media NAO ponderada das taxas diarias dos ultimos 30 dias, como o original. Sem gate de atraso, tambem como o original (la ele esta comentado).
	measure 'Δ BL|1M splash' = ```
			
			        VAR _BL  = [Baseline splash]
			        VAR _Fim = MAX( 'Dim_Data'[Data] )
			        VAR _Mes =
			            CALCULATE(
			                DIVIDE( SUM( Fato_Solda[count_Tem_Splash] ), SUM( Fato_Solda[row_count] ) ),
			                DATESINPERIOD( 'Dim_Data'[Data], _Fim, -30, DAY )
			            )
			        RETURN
			            IF( ISBLANK( _Mes ), BLANK(), _Mes - _BL )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Score Splash
		lineageTag: e06e4ac2-eab4-482f-9694-4570cbd96fb2

	/// Tendencia do splash em graus, espelhando [β1 pha2]: regressao contra a data sobre a serie diaria, janela 365 d, min-max nos dois eixos. Substitui [β1 Splash] no [Score Splash] porque aquela regride cru e nunca passa de 0,24 grau.
	measure 'β1 Splash (mm)' =
			-- Espelha [β1 pha2] ponto a ponto, sobre a serie DIARIA de splash: regressao
			-- contra a DATA, janela fixa de 365 dias, min-max nos DOIS eixos, resultado em graus.
			-- A normalizacao min-max e o ponto todo. [β1 Splash] (a antiga, que segue intacta)
			-- regride CRU: X_Eixo vai de 0 a 243 e a taxa de 0 a 1, entao a inclinacao nao passa
			-- de 1/243 e o angulo nao passa de 0,24 grau -- contra um teto de 40 graus no Score,
			-- entregava menos de 1% do peso do criterio. Normalizado, o angulo usa a faixa +-45.
			-- Constroi a serie diaria com SUMMARIZE em vez de FILTER(ALL(tabela)): nao expande a
			-- tabela de fatos inteira, o que alem de rapido evita depender de colunas calculadas.
			VAR _Timer = SELECTEDVALUE ( Fato_Solda[timerName] )
			VAR _Fim   = MAX ( Fato_Solda[Data] )
			VAR _Ini   = _Fim - 364                                  -- W = 365 d, fixo, como [β1 pha2]
			VAR _S =
			    FILTER (
			        CALCULATETABLE (
			            SUMMARIZE (
			                Fato_Solda,
			                Fato_Solda[Data],
			                "@n", SUM ( Fato_Solda[row_count] ),
			                "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			            )
			        ),
			        Fato_Solda[Data] >= _Ini && Fato_Solda[Data] <= _Fim
			    )
			VAR _T0   = ADDCOLUMNS ( _S, "@y", DIVIDE ( [@s], [@n] ) )
			VAR _MinX = MINX ( _T0, INT ( Fato_Solda[Data] ) )
			VAR _MaxX = MAXX ( _T0, INT ( Fato_Solda[Data] ) )
			VAR _MinY = MINX ( _T0, [@y] )
			VAR _MaxY = MAXX ( _T0, [@y] )
			VAR _N =
			    ADDCOLUMNS (
			        _T0,
			        "Xn", DIVIDE ( INT ( Fato_Solda[Data] ) - _MinX, _MaxX - _MinX ),
			        "Yn", DIVIDE ( [@y] - _MinY, _MaxY - _MinY )
			    )
			VAR _mx  = AVERAGEX ( _N, [Xn] )
			VAR _my  = AVERAGEX ( _N, [Yn] )
			VAR _D   = ADDCOLUMNS ( _N, "dx", [Xn] - _mx, "dy", [Yn] - _my )
			VAR _cov = SUMX ( _D, [dx] * [dy] )
			VAR _var = SUMX ( _D, [dx] * [dx] )
			RETURN
			    IF ( _var = 0, BLANK (), DEGREES ( ATAN ( DIVIDE ( _cov, _var ) ) ) )
		formatString: 0.00
		displayFolder: Score Splash
		lineageTag: cbb3ce46-38ad-48b9-b336-401dc33df93b

	/// Como [β1 Splash (mm)], com peso de recencia EXP(-0,17 * atraso), espelhando [β1 pha2_norm]. E o criterio de 'aceleracao' do [Score Splash].
	measure 'β1 Splash_norm (mm)' =
			-- Espelha [β1 pha2_norm] ponto a ponto, sobre a serie DIARIA de splash: regressao
			-- contra a DATA, janela fixa de 365 dias, min-max nos DOIS eixos, resultado em graus.
			-- A normalizacao min-max e o ponto todo. [β1 Splash] (a antiga, que segue intacta)
			-- regride CRU: X_Eixo vai de 0 a 243 e a taxa de 0 a 1, entao a inclinacao nao passa
			-- de 1/243 e o angulo nao passa de 0,24 grau -- contra um teto de 80 graus no Score,
			-- entregava menos de 1% do peso do criterio. Normalizado, o angulo usa a faixa +-45.
			-- Constroi a serie diaria com SUMMARIZE em vez de FILTER(ALL(tabela)): nao expande a
			-- tabela de fatos inteira, o que alem de rapido evita depender de colunas calculadas.
			-- Peso de recencia EXP(-0,17 * atraso), o mesmo expoente de [β1 pha2_norm].
			VAR _Timer = SELECTEDVALUE ( Fato_Solda[timerName] )
			VAR _Fim   = MAX ( Fato_Solda[Data] )
			VAR _Ini   = _Fim - 364                                  -- W = 365 d, fixo, como [β1 pha2]
			VAR _S =
			    FILTER (
			        CALCULATETABLE (
			            SUMMARIZE (
			                Fato_Solda,
			                Fato_Solda[Data],
			                "@n", SUM ( Fato_Solda[row_count] ),
			                "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			            )
			        ),
			        Fato_Solda[Data] >= _Ini && Fato_Solda[Data] <= _Fim
			    )
			VAR _T0   = ADDCOLUMNS ( _S, "@y", DIVIDE ( [@s], [@n] ) )
			VAR _MinX = MINX ( _T0, INT ( Fato_Solda[Data] ) )
			VAR _MaxX = MAXX ( _T0, INT ( Fato_Solda[Data] ) )
			VAR _MinY = MINX ( _T0, [@y] )
			VAR _MaxY = MAXX ( _T0, [@y] )
			VAR _N =
			    ADDCOLUMNS (
			        _T0,
			        "W",  EXP ( -0.17 * ( _Fim - Fato_Solda[Data] ) ),
			        "Xn", DIVIDE ( INT ( Fato_Solda[Data] ) - _MinX, _MaxX - _MinX ),
			        "Yn", DIVIDE ( [@y] - _MinY, _MaxY - _MinY )
			    )
			VAR _sw  = SUMX ( _N, [W] )
			VAR _mx  = DIVIDE ( SUMX ( _N, [Xn] * [W] ), _sw )
			VAR _my  = DIVIDE ( SUMX ( _N, [Yn] * [W] ), _sw )
			VAR _D   = ADDCOLUMNS ( _N, "dx", [Xn] - _mx, "dy", [Yn] - _my )
			VAR _cov = SUMX ( _D, [W] * [dx] * [dy] )
			VAR _var = SUMX ( _D, [W] * [dx] * [dx] )
			RETURN
			    IF ( _var = 0, BLANK (), DEGREES ( ATAN ( DIVIDE ( _cov, _var ) ) ) )
		formatString: 0.00
		displayFolder: Score Splash
		lineageTag: c4851eb0-4e32-4426-8f3c-53f0465e3211

	measure 'Pts Nível Dia' =
			-- Componente 2 da cascata da tela 3.3. A soma dos SEIS devolve [Score Splash]
			-- (a menos do ROUND final, que so o Score aplica).
			VAR _Limit_B1N  = 80.0     -- graus, igual ao [Score]
			VAR _Limit_BL1D = 0.85     -- taxa de splash, 0 a 1
			VAR _Limit_BL1M = 0.85     -- taxa de splash, 0 a 1
			VAR _Limit_B1   = 40.0     -- graus, igual ao [Score]
			
			VAR _Val_B1N  = COALESCE( [β1 Splash_norm (mm)], 0 )
			VAR _Val_BL1D = COALESCE( [Δ BL|1D splash], 0 )
			VAR _Val_BL1M = COALESCE( [Δ BL|1M splash], 0 )
			VAR _Val_B1   = COALESCE( [β1 Splash (mm)], 0 )
			
			VAR _a = DIVIDE( IF(_Val_B1N <0,0,IF(_Val_B1N >_Limit_B1N, _Limit_B1N, _Val_B1N )), _Limit_B1N  )
			VAR _b = DIVIDE( IF(_Val_BL1D<0,0,IF(_Val_BL1D>_Limit_BL1D,_Limit_BL1D,_Val_BL1D)), _Limit_BL1D )
			VAR _c = DIVIDE( IF(_Val_BL1M<0,0,IF(_Val_BL1M>_Limit_BL1M,_Limit_BL1M,_Val_BL1M)), _Limit_BL1M )
			VAR _d = DIVIDE( IF(_Val_B1  <0,0,IF(_Val_B1  >_Limit_B1,  _Limit_B1,  _Val_B1  )), _Limit_B1   )
			VAR _T = 22
			RETURN
			    ( _b * DIVIDE( 5, _T ) ) * 100
		formatString: 0.0
		displayFolder: Tela 3.3
		lineageTag: fff5297d-c3d7-48ba-b2b0-a42738e45a3a

