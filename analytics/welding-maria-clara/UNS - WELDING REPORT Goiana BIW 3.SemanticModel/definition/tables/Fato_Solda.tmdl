	/// Nivel dos ULTIMOS 30 DIAS contra o baseline, em fracao. Antes era MEDIAN sobre 360 dias -- um ANO, apesar do "1M" no nome -- e mediana de LINHA, nao de dia. Agora e a media das MEDIAS DIARIAS da janela de 30 dias que termina no ultimo dia com pha2 > 0, e nao na borda do slicer: slicer esticado alem do fim dos dados esvaziava a janela. Mesma unidade de [Δ BL|1D pha2] (ponto de dia contra baseline), o que importa porque o [Score] mede as duas com o mesmo teto de 0,33. Dia sem solda devolve BLANK e sai da media, nao entra como zero.
	measure 'Δ BL|1M pha2' = ```
			
			VAR _BL  = [Baseline pha2]
			VAR _Fim =
			    CALCULATE( MAX( 'Fato_Solda'[Data] ), 'Fato_Solda'[pha2] > 0 )
			VAR _Dias =
			    CALCULATETABLE(
			        VALUES( 'Dim_Data'[Data] ),
			        DATESINPERIOD( 'Dim_Data'[Data], _Fim, -30, DAY )
			    )
			VAR _Mes =
			    AVERAGEX(
			        _Dias,
			        CALCULATE( AVERAGE( 'Fato_Solda'[pha2] ), 'Fato_Solda'[pha2] > 0 )
			    )
			RETURN
			    IF( ISBLANK( _BL ) || ISBLANK( _Mes ), BLANK(),
			        DIVIDE( _Mes - _BL, _BL ) )
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a4c8c561-f6dc-4bf7-b9e8-2b9db61bb312

	/// Nivel do ULTIMO DIA com medicao contra o baseline, em fracao. Antes era MEDIAN sobre TODO o periodo filtrado, o que nao e "1D": devolvia a distancia historica media do robo, nao a de hoje. Agora acha o ultimo dia com pha2 > 0 dentro do filtro e usa a MEDIA desse dia -- a mesma conta da serie diaria (Fato_PHA2_Diario = AVG(pha2) por dia) e do grafico "Media de pha2". Media NAO ponderada por row_count, de proposito, para bater com o grafico. Vazio sem baseline ou sem dia com medicao.
	measure 'Δ BL|1D pha2' =
			
			VAR _BL  = [Baseline pha2]
			VAR _UltDia =
			    CALCULATE(
			        MAX( 'Fato_Solda'[Data] ),
			        'Fato_Solda'[pha2] > 0
			    )
			VAR _Dia =
			    CALCULATE(
			        AVERAGE( 'Fato_Solda'[pha2] ),
			        'Fato_Solda'[Data] = _UltDia,
			        'Fato_Solda'[pha2] > 0
			    )
			RETURN
			    IF( ISBLANK( _BL ) || ISBLANK( _Dia ), BLANK(),
			        DIVIDE( _Dia - _BL, _BL ) )
		lineageTag: 7d62e2dc-e138-4691-93bb-49bb804c9bec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'β1 pha2' =
			
			VAR _Pinca = SELECTEDVALUE( Fato_Solda[electrodeNo] )
			VAR _Fim   = MAX( Fato_Solda[Data] )
			VAR _Ini   = _Fim - 364                                  -- W = 365 d, fixo
			VAR _S = FILTER(
			             CALCULATETABLE( Fato_PHA2_Diario,
			                 REMOVEFILTERS( Fato_PHA2_Diario[timerName] ),
			                 Fato_PHA2_Diario[timerName] = _Pinca ),
			             Fato_PHA2_Diario[Data] >= _Ini
			             && Fato_PHA2_Diario[Data] <= _Fim )
			VAR _MinX = MINX( _S, INT( Fato_PHA2_Diario[Data] ) )
			VAR _MaxX = MAXX( _S, INT( Fato_PHA2_Diario[Data] ) )
			VAR _MinY = MINX( _S, Fato_PHA2_Diario[pha2_dia] )
			VAR _MaxY = MAXX( _S, Fato_PHA2_Diario[pha2_dia] )
			VAR _N = ADDCOLUMNS( _S,
			        "Xn", DIVIDE( INT( Fato_PHA2_Diario[Data] ) - _MinX, _MaxX - _MinX ),
			        "Yn", DIVIDE( Fato_PHA2_Diario[pha2_dia] - _MinY, _MaxY - _MinY ) )
			VAR _mx = AVERAGEX( _N, [Xn] )
			VAR _my = AVERAGEX( _N, [Yn] )
			VAR _D  = ADDCOLUMNS( _N, "dx", [Xn] - _mx, "dy", [Yn] - _my )
			VAR _cov = SUMX( _D, [dx] * [dy] )
			VAR _var = SUMX( _D, [dx] * [dx] )
			RETURN IF( _var = 0, BLANK(), DEGREES( ATAN( DIVIDE( _cov, _var ) ) ) )
		lineageTag: 6ff2585f-1180-45f8-ad8f-65a05e845c30

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'β0 pha2' = ```
			
			VAR CurrPinca = SELECTEDVALUE('Fato_Solda'[electrodeNo])
			VAR BaseFiltrada =
			    CALCULATETABLE(
			        'Fato_Solda',
			        REMOVEFILTERS('Fato_Solda'[electrodeNo]),
			        'Fato_Solda'[electrodeNo] = CurrPinca
			    )
			VAR MediaX = AVERAGEX(BaseFiltrada, 'Fato_Solda'[X_Eixo])
			VAR MediaY = AVERAGEX(BaseFiltrada, 'Fato_Solda'[pha2])
			VAR beta1 =
			    VAR TabelaDif =
			        ADDCOLUMNS(
			            BaseFiltrada,
			            "DifX", 'Fato_Solda'[X_Eixo] - MediaX,
			            "DifY", 'Fato_Solda'[pha2] - MediaY
			        )
			    VAR CovXY = SUMX(TabelaDif, [DifX] * [DifY])
			    VAR VariX = SUMX(TabelaDif, [DifX] * [DifX])
			    RETURN IF(VariX = 0, BLANK(), CovXY / VariX)
			RETURN
			    MediaY - beta1 * MediaX
			
			```
		lineageTag: 970f5c65-5c1e-4cdf-97c0-d4f60f138ed6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'β1 pha2_norm' =
			
			VAR _Pinca = SELECTEDVALUE( Fato_Solda[electrodeNo] )
			VAR _Fim   = MAX( Fato_Solda[Data] )
			VAR _Ini   = _Fim - 364
			VAR _S = FILTER(
			             CALCULATETABLE( Fato_PHA2_Diario,
			                 REMOVEFILTERS( Fato_PHA2_Diario[timerName] ),
			                 Fato_PHA2_Diario[timerName] = _Pinca ),
			             Fato_PHA2_Diario[Data] >= _Ini
			             && Fato_PHA2_Diario[Data] <= _Fim )
			VAR _MinX = MINX( _S, INT( Fato_PHA2_Diario[Data] ) )
			VAR _MaxX = MAXX( _S, INT( Fato_PHA2_Diario[Data] ) )
			VAR _MinY = MINX( _S, Fato_PHA2_Diario[pha2_dia] )
			VAR _MaxY = MAXX( _S, Fato_PHA2_Diario[pha2_dia] )
			VAR _N = ADDCOLUMNS( _S,
			        "W",  EXP( -0.17 * ( _Fim - Fato_PHA2_Diario[Data] ) ),   -- λ = 0,2
			        "Xn", DIVIDE( INT( Fato_PHA2_Diario[Data] ) - _MinX, _MaxX - _MinX ),
			        "Yn", DIVIDE( Fato_PHA2_Diario[pha2_dia] - _MinY, _MaxY - _MinY ) )
			VAR _sw = SUMX( _N, [W] )
			VAR _mx = DIVIDE( SUMX( _N, [Xn] * [W] ), _sw )
			VAR _my = DIVIDE( SUMX( _N, [Yn] * [W] ), _sw )
			VAR _D  = ADDCOLUMNS( _N, "dx", [Xn] - _mx, "dy", [Yn] - _my )
			VAR _cov = SUMX( _D, [W] * [dx] * [dy] )
			VAR _var = SUMX( _D, [W] * [dx] * [dx] )
			RETURN IF( _var = 0, BLANK(), DEGREES( ATAN( DIVIDE( _cov, _var ) ) ) )
		lineageTag: 9d5246ff-31bc-42d6-a2c6-e19003d8fa47

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Δ 1M|1M_resistanceActualValue' = ```
			
			VAR DataReferencia = MAX(Fato_Solda[dateTime])
			VAR DataMesAnterior = EDATE(DataReferencia, -1) 
			
			VAR MediaMesAtual = 
			    CALCULATE(
			        MEDIAN(Fato_Solda[resistanceActualValue]),
			        MONTH(Fato_Solda[dateTime]) = MONTH(DataReferencia),
			        YEAR(Fato_Solda[dateTime]) = YEAR(DataReferencia)
			    )
			
			VAR MediaMesAnterior = 
			    CALCULATE(
			        MEDIAN(Fato_Solda[resistanceActualValue]),
			        MONTH(Fato_Solda[dateTime]) = MONTH(DataMesAnterior),
			        YEAR(Fato_Solda[dateTime]) = YEAR(DataMesAnterior)
			    )
			
			VAR Percentual = 
			    DIVIDE(
			        MediaMesAtual - MediaMesAnterior, 
			        MediaMesAnterior
			    )
			
			RETURN 
			    Percentual
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 402e17ad-e687-48b7-977f-56d13247c30b

