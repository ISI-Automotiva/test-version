	measure 'Pincas Criticas' =
			-- Capa: pincas com Score acima do corte critico (32).
			COUNTROWS ( FILTER ( VALUES ( Dim_Pinca[pinca] ), [Score] > 32 ) )
		formatString: 0
		displayFolder: Capa
		lineageTag: 0a669036-842e-4b39-bc89-35a7e3c79d74

	measure 'Alarmes 24h' =
			-- Capa: erros do ultimo dia com registro.
			VAR _ult = MAX ( Fato_Erro[Data] )
			RETURN
			    CALCULATE ( SUM ( Fato_Erro[total_erros] ), KEEPFILTERS ( Fato_Erro[Data] = _ult ) )
		formatString: #,0
		displayFolder: Capa
		lineageTag: 6e59fa92-35fd-4533-b373-706152040653

	measure 'Robos com Alarme' =
			-- Capa: quantos robos distintos geraram alarme no ultimo dia.
			VAR _ult = MAX ( Fato_Erro[Data] )
			RETURN
			    CALCULATE ( DISTINCTCOUNT ( Fato_Erro[timerName] ), KEEPFILTERS ( Fato_Erro[Data] = _ult ) )
		formatString: 0
		displayFolder: Capa
		lineageTag: a02adee4-8e0d-4826-b64a-3093a4d4bf0b

	measure 'Pincas sem Dado' =
			-- Capa: pincas sem nenhuma medicao ligada.
			COUNTROWS ( FILTER ( VALUES ( Dim_Pinca[pinca] ), NOT [Splash Tem Medição] ) )
		formatString: 0
		displayFolder: Capa
		lineageTag: 09ccdf13-40fe-4f12-8108-acc6752f02a0

	measure 'Cobertura de Medicao' =
			-- Capa: fracao das pincas com medicao ligada.
			VAR _tot = COUNTROWS ( VALUES ( Dim_Pinca[pinca] ) )
			RETURN DIVIDE ( _tot - [Pincas sem Dado], _tot )
		formatString: 0.0%
		displayFolder: Capa
		lineageTag: 9e76f7bc-fe44-4f6c-a576-4e8f69a7db4f

