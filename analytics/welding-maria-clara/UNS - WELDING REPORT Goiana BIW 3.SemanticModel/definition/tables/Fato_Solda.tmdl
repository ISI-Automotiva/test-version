	measure '% Splash (v2)' =
			DIVIDE(
			    SUM(Fato_Solda[count_Tem_Splash]),
			    SUM(Fato_Solda[row_count])
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Score Splash
		lineageTag: 98ee0159-ac90-439a-a024-ff75144596b7

	/// Taxa diaria do [Robo em Foco] sobre TODAS as soldas dele. Remove Modelo/spotName/StatusDADOS de proposito: sao filtros que fatiam o dia. E a serie azul da 3.3 -- [Reta Beta S] e [Reta Beta W S] precisam remover os mesmos filtros, senao a reta descreve outra populacao que os pontos.
	measure '% Splash (Foco)' =
			VAR _robo = [Robô em Foco]
			VAR _MinN = 100.0
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			VAR _Ok = FILTER ( _Dias, [@n] >= _MinN )
			RETURN
			    DIVIDE ( SUMX ( _Ok, [@s] ), SUMX ( _Ok, [@n] ) )
		formatString: 0.0%
		displayFolder: Tela 3.3
		lineageTag: 8c761ef1-44e4-4231-b489-9ea97f4553b4

	/// Inclinacao da taxa diaria de splash, em pp por dia. Positivo = piorando. Minimos quadrados ponderados pelo VOLUME do dia (a variancia de uma proporcao e p(1-p)/n, entao dia ralo pesa pouco). Ignora o filtro de data: usa sempre a janela [Janela_Beta].
	measure Beta =
			
			VAR _MinDias = 7.0
			VAR _JanelaParam = 180.0
			
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			-- Exclui apagao de medicao (volume alto com zero splash = sensor desligado).
			VAR _Base = FILTER ( _Dias, NOT ( [@s] = 0 && [@n] >= 500 ) )
			VAR _xmin = MINX ( _Base, INT ( Fato_Solda[Data] ) )
			
			VAR _T =
			    ADDCOLUMNS (
			        _Base,
			        "@x", INT ( Fato_Solda[Data] ) - _xmin + 0.0,
			        "@y", DIVIDE ( [@s], [@n] ) * 100.0,
			        "@w", [@n] + 0.0
			    )
			
			VAR _n   = COUNTROWS ( _T )
			VAR _W   = SUMX ( _T, [@w] )
			VAR _Mx  = DIVIDE ( SUMX ( _T, [@w] * [@x] ), _W )
			VAR _My  = DIVIDE ( SUMX ( _T, [@w] * [@y] ), _W )
			VAR _Cov = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@y] - _My ) )
			VAR _Var = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@x] - _Mx ) )
			
			RETURN
			    IF (
			        _n < _MinDias || _Var = 0 || _W = 0,
			        BLANK (),
			        DIVIDE ( _Cov, _Var )
			    )
		formatString: 0.000
		displayFolder: Criticidade x Splash
		lineageTag: af424116-69fd-4f9d-8df0-68e92e644bf8

	/// Igual a [Beta], mas o peso tambem cai com a idade do dia (meia-vida [MeiaVida_BetaW]). MESMA janela de [Beta] -- o que diferencia e o peso, nao um corte mais curto da serie. Beta W bem maior que Beta indica piora concentrada nos ultimos dias.
	measure 'Beta W' =
			VAR _Lambda = DIVIDE( LN ( 2 ), 10.0 )
			VAR _MinDias = 7.0
			VAR _JanelaParam = 180.0
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			
			-- Exclui apagao de medicao (volume alto com zero splash = sensor desligado).
			VAR _Base = FILTER ( _Dias, NOT ( [@s] = 0 && [@n] >= 500 ) )
			VAR _xmax = MAXX ( _Base, INT ( Fato_Solda[Data] ) )
			
			VAR _T =
			    ADDCOLUMNS (
			        _Base,
			        "@x", INT ( Fato_Solda[Data] ) - _xmax + 0.0,
			        "@y", DIVIDE ( [@s], [@n] ) * 100.0,
			        "@w",
			            VAR _atraso   = _xmax - INT ( Fato_Solda[Data] )
			            VAR _expoente = - _Lambda * _atraso
			            VAR _expSeguro = MAX ( MIN ( _expoente, 500 ), -500 )
			            RETURN ( [@n] + 0.0 ) * EXP ( _expSeguro )
			    )
			
			VAR _n   = COUNTROWS ( _T )
			VAR _W   = SUMX ( _T, [@w] )
			VAR _Mx  = DIVIDE ( SUMX ( _T, [@w] * [@x] ), _W )
			VAR _My  = DIVIDE ( SUMX ( _T, [@w] * [@y] ), _W )
			VAR _Cov = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@y] - _My ) )
			VAR _Var = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@x] - _Mx ) )
			
			RETURN
			    IF (
			        _n < _MinDias || _Var = 0 || _W = 0,
			        BLANK (),
			        DIVIDE ( _Cov, _Var )
			    )
		displayFolder: Criticidade x Splash
		lineageTag: d63b3ed1-0952-40a5-9f0a-a061b1044b02

	/// Rotulo da estabilidade da tendencia: Consistente (R2 >= 0,50), Variavel (>= 0,20), Instavel, ou "Sem base" abaixo de Min_Dias_Beta. Qualifica a LEITURA da tendencia, nao a qualidade do dado nem a prioridade.
	measure 'Confiança da Tendência' =
			
			VAR _R2   = [R2 Splash]
			VAR _Dias = [Dias com dado]
			VAR _MinD = 7.0
			
			VAR _Sufixo =
			    IF ( ISFILTERED ( Fato_Solda[spotName] ), " (grão de ponto: ruído)", "" )
			
			VAR _Faixa =
			    SWITCH(
			        TRUE(),
			        ISBLANK( _R2 ) && COALESCE( _Dias, 0 ) < _MinD,
			            "Sem base (" & COALESCE( _Dias, 0 ) & " de " & INT( _MinD ) & " dias)",
			        ISBLANK( _R2 ), "Reta indefinida",
			        _R2 = 0,        "Sem variação",
			        _R2 >= 0.50,    "Consistente",
			        _R2 >= 0.20,    "Pouco estável",
			                        "Instável"
			    )
			
			RETURN _Faixa & _Sufixo
		lineageTag: 90e010ac-5e3c-4b2c-817b-0e0a160e9815

	/// Ultimo dia da janela de [Beta W], apos excluir apagao. E a ancora da reta ponderada: [Beta] ancora no INICIO da janela, [Beta W] no FIM, porque pondera por recencia.
	measure 'Data Fim Regressão W' =
			VAR _JanelaParam = 180.0
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			
			-- Exclui apagao de medicao (volume alto com zero splash = sensor desligado).
			VAR _Base = FILTER ( _Dias, NOT ( [@s] = 0 && [@n] >= 500 ) )
			RETURN MAXX ( _Base, Fato_Solda[Data] )
		formatString: dd/mm/yyyy
		displayFolder: Criticidade x Splash
		lineageTag: 11f39d1b-2ac2-4ce2-8790-14587da4ca28

	/// Primeiro dia da janela de [Beta], apos excluir apagao. E a ancora (dia zero) da reta. Mesma janela de [Beta]/[β0 Splash], pelo motivo descrito em [β0 Splash].
	measure 'Data Início Regressão S' =
			VAR _JanelaParam = 180.0
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			
			-- Exclui apagao de medicao (volume alto com zero splash = sensor desligado).
			VAR _Base = FILTER ( _Dias, NOT ( [@s] = 0 && [@n] >= 500 ) )
			RETURN MINX ( _Base, Fato_Solda[Data] )
		formatString: dd/mm/yyyy
		displayFolder: Criticidade x Splash
		lineageTag: 038b653c-5fe1-4f3d-bb31-ee9f9619d87a

	/// Dias com solda dentro da janela [Janela_Beta]. NUNCA devolve BLANK: e ela que explica o vazio de [Beta], [Beta W] e [R2 Splash], entao precisa mostrar o numero que reprovou no piso Min_Dias_Beta.
	measure 'Dias com dado' =
			VAR _JanelaParam = 180.0
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			RETURN
			COUNTROWS (
			    CALCULATETABLE (
			        SUMMARIZE ( Fato_Solda, Fato_Solda[Data] ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			)
		formatString: 0
		lineageTag: 61fa2c8a-9394-49c4-b265-795b579d96aa

	/// Robo em foco com Nivel e Score em texto -- os MESMOS valores que o mapa da 3.3 plota nos eixos X e Y.
	measure 'Foco no Mapa' =
			VAR _robo = [Robô em Foco]
			VAR _x = CALCULATE ( [% Splash (v2)], REMOVEFILTERS ( Fato_Solda[timerName] ), Fato_Solda[timerName] = _robo )
			VAR _y = CALCULATE ( [Score Splash], REMOVEFILTERS ( Fato_Solda[timerName] ), Fato_Solda[timerName] = _robo )
			RETURN
			    IF (
			        NOT ISBLANK ( _robo ),
			        _robo
			            & IF (
			                NOT ISBLANK ( _y ),
			                "     |     Splash " & FORMAT ( _x, "0.0%" ) & "     |     Score " & FORMAT ( _y, "0.0" )
			            )
			    )
		displayFolder: Tela 3.3
		lineageTag: 2ff98ad3-3487-45ec-96df-25022b26a052

	/// Mediana da taxa DIARIA de splash, em pontos percentuais. O grao e o dia, nao a solda (splash e booleano por solda). Diferente das Betas, SEGUE o filtro de data da pagina.
	measure Mediana =
			VAR _Dias =
			    SUMMARIZE (
			        Fato_Solda,
			        Fato_Solda[Data],
			        "@n", SUM ( Fato_Solda[row_count] ),
			        "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			    )
			RETURN
			    IF (
			        COUNTROWS ( _Dias ) > 0,
			        MEDIANX ( _Dias, DIVIDE ( [@s], [@n] ) * 100.0 )
			    )
		formatString: 0.00
		displayFolder: Criticidade x Splash
		lineageTag: f82360f3-1413-4a35-99d9-a3709de636c0

	/// Por que o robo nao tem [Score Splash]; vazio quando tem. Os ramos seguem a ordem das guardas do Score: aparece o primeiro motivo que reprova. Sem isso o robo sem nota sumiria da tela, e "fora da fila" seria lido como "esta bem".
	measure 'Motivo Sem Score' =
			VAR _sc = [Score Splash]
			VAR _Nivel = [% Splash (v2)]
			VAR _Splashes = COALESCE ( SUM ( Fato_Solda[count_Tem_Splash] ), 0 )
			VAR _MinSplashes = 1.0
			VAR _Dias = COALESCE ( [Dias com dado], 0 )
			VAR _MinD = 7.0
			VAR _TemMedicao =
			    COALESCE (
			        CALCULATE (
			            COUNTROWS ( Fato_Solda ),
			            REMOVEFILTERS ( Fato_Solda[Status_Measuring] ),
			            Fato_Solda[Status_Measuring] = "Ligado"
			        ),
			        0
			    ) > 0
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _sc ),        BLANK (),                         -- tem nota
			        NOT _TemMedicao,            "Sem medição (sensor desligado)",
			        ISBLANK ( _Nivel ),         "Sem soldas no recorte",
			        _Splashes < _MinSplashes,   "Sem splashes suficientes",
			        _Dias < _MinD,              "Sem dias de série (" & _Dias & " de " & INT ( _MinD ) & ")",
			                                    "Sem critério de variação"
			    )
		displayFolder: Tela 3.3
		lineageTag: 9f66d60b-5959-475d-ba2a-3f459e5af922

	/// Pontos da nota vindos da ACELERACAO, ja amortecidos pela confianca do R2. Termo exato do [Score Splash].
	measure 'Pts Aceleração' =
			-- Componente 1 da cascata da tela 3.3. A soma dos SEIS devolve [Score Splash]
			-- (a menos do ROUND final, que so o Score aplica).
			VAR _Limit_B1N  = 80.0     -- graus, igual ao [Score]
			VAR _Limit_BL1D = 0.85     -- taxa de splash, 0 a 1
			VAR _Limit_BL1M = 0.85     -- taxa de splash, 0 a 1
			VAR _Limit_B1   = 40.0     -- graus, igual ao [Score]
			
			VAR _Val_B1N  = COALESCE( [β1 Splash_norm (mm)], 0 )
			VAR _Val_BL1D = COALESCE( [Δ BL|1D splash], 0 )
			VAR _Val_BL1M = COALESCE( [Δ BL|1M splash], 0 )
			VAR _Val_B1   = COALESCE( [β1 Splash (mm)], 0 )
			
			VAR _a = DIVIDE( IF(_Val_B1N <0,0,IF(_Val_B1N >_Limit_B1N, _Limit_B1N, _Val_B1N )), _Limit_B1N  )
			VAR _b = DIVIDE( IF(_Val_BL1D<0,0,IF(_Val_BL1D>_Limit_BL1D,_Limit_BL1D,_Val_BL1D)), _Limit_BL1D )
			VAR _c = DIVIDE( IF(_Val_BL1M<0,0,IF(_Val_BL1M>_Limit_BL1M,_Limit_BL1M,_Val_BL1M)), _Limit_BL1M )
			VAR _d = DIVIDE( IF(_Val_B1  <0,0,IF(_Val_B1  >_Limit_B1,  _Limit_B1,  _Val_B1  )), _Limit_B1   )
			VAR _T = 22
			RETURN
			    ( _a * DIVIDE( 4, _T ) ) * 100
		formatString: 0.0
		displayFolder: Tela 3.3
		lineageTag: c77f236a-0749-4005-bc43-0a099e983d7a

	/// Pontos da nota vindos da TENDENCIA, ja amortecidos pela confianca do R2. Termo exato do [Score Splash].
	measure 'Pts Tendência' =
			-- Componente 4 da cascata da tela 3.3. A soma dos SEIS devolve [Score Splash]
			-- (a menos do ROUND final, que so o Score aplica).
			VAR _Limit_B1N  = 80.0     -- graus, igual ao [Score]
			VAR _Limit_BL1D = 0.85     -- taxa de splash, 0 a 1
			VAR _Limit_BL1M = 0.85     -- taxa de splash, 0 a 1
			VAR _Limit_B1   = 40.0     -- graus, igual ao [Score]
			
			VAR _Val_B1N  = COALESCE( [β1 Splash_norm (mm)], 0 )
			VAR _Val_BL1D = COALESCE( [Δ BL|1D splash], 0 )
			VAR _Val_BL1M = COALESCE( [Δ BL|1M splash], 0 )
			VAR _Val_B1   = COALESCE( [β1 Splash (mm)], 0 )
			
			VAR _a = DIVIDE( IF(_Val_B1N <0,0,IF(_Val_B1N >_Limit_B1N, _Limit_B1N, _Val_B1N )), _Limit_B1N  )
			VAR _b = DIVIDE( IF(_Val_BL1D<0,0,IF(_Val_BL1D>_Limit_BL1D,_Limit_BL1D,_Val_BL1D)), _Limit_BL1D )
			VAR _c = DIVIDE( IF(_Val_BL1M<0,0,IF(_Val_BL1M>_Limit_BL1M,_Limit_BL1M,_Val_BL1M)), _Limit_BL1M )
			VAR _d = DIVIDE( IF(_Val_B1  <0,0,IF(_Val_B1  >_Limit_B1,  _Limit_B1,  _Val_B1  )), _Limit_B1   )
			VAR _T = 22
			RETURN
			    ( _d * DIVIDE( 3, _T ) ) * 100
		formatString: 0.0
		displayFolder: Tela 3.3
		lineageTag: 6195874d-3a6a-4d2d-8800-8693d67430ec

	/// Quanto da variacao diaria a reta de [Beta] explica, de 0 a 1. Mesmos pesos de [Beta]. Serie plana devolve 0 (tendencia nula e conhecida, nao ausencia); BLANK so abaixo de Min_Dias_Beta.
	measure 'R2 Splash' =
			VAR _MinDias = 7.0
			VAR _JanelaParam = 180.0
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			
			-- Exclui apagao de medicao (volume alto com zero splash = sensor desligado).
			VAR _Base = FILTER ( _Dias, NOT ( [@s] = 0 && [@n] >= 500 ) )
			
			VAR _xmin = MINX ( _Base, INT ( Fato_Solda[Data] ) )
			
			VAR _T =
			    ADDCOLUMNS (
			        _Base,
			        "@x", INT ( Fato_Solda[Data] ) - _xmin + 0.0,
			        "@y", DIVIDE ( [@s], [@n] ) * 100.0,
			        "@w", [@n] + 0.0
			    )
			
			VAR _n    = COUNTROWS ( _T )
			VAR _W    = SUMX ( _T, [@w] )
			VAR _Mx   = DIVIDE ( SUMX ( _T, [@w] * [@x] ), _W )
			VAR _My   = DIVIDE ( SUMX ( _T, [@w] * [@y] ), _W )
			VAR _Cov  = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@y] - _My ) )
			VAR _VarX = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@x] - _Mx ) )
			VAR _VarY = SUMX ( _T, [@w] * ( [@y] - _My ) * ( [@y] - _My ) )
			
			RETURN
			    SWITCH (
			        TRUE (),
			        _n < _MinDias, BLANK (),   -- sem dado para regredir
			        _W = 0,        BLANK (),   -- nenhuma solda na janela
			        _VarX = 0,     BLANK (),   -- um unico dia distinto, reta indefinida
			        _VarY = 0,     0,          -- serie plana: tendencia conhecida e nula
			        DIVIDE ( _Cov * _Cov, _VarX * _VarY )
			    )
		formatString: 0.000
		lineageTag: 14f47eb9-15e7-499e-a26e-80fb0aa39516

	/// Valor previsto pela reta de [Beta] para o dia do eixo, em fracao (0 a 1), para desenhar sobre [% Splash (Foco)]. Fixa o [Robo em Foco] e remove Modelo/spotName/StatusDADOS igual a [% Splash (Foco)].
	measure 'Reta Beta S' =
			VAR _robo = [Robô em Foco]
			VAR _dia  = MAX ( Fato_Solda[Data] )
			VAR _b =
			    CALCULATE (
			        [Beta],
			        ALLSELECTED ( Fato_Solda[Data] ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			VAR _b0 =
			    CALCULATE (
			        [β0 Splash],
			        ALLSELECTED ( Fato_Solda[Data] ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			VAR _ini =
			    CALCULATE (
			        [Data Início Regressão S],
			        ALLSELECTED ( Fato_Solda[Data] ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			RETURN
			    IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _ini ) && INT ( _dia ) >= INT ( _ini ),
			         ( _b0 + _b * ( INT ( _dia ) - INT ( _ini ) ) ) / 100 )
		formatString: 0.0%
		displayFolder: Criticidade x Splash
		lineageTag: 7a2453f9-50a3-4de0-b76c-edd61bf987ac

	/// Igual a [Reta Beta S], mas alimentada pela regressao ponderada. Ancora em [Data Fim Regressao W], nao no inicio da janela.
	measure 'Reta Beta W S' =
			VAR _robo = [Robô em Foco]
			VAR _dia  = MAX ( Fato_Solda[Data] )
			VAR _b =
			    CALCULATE (
			        [Beta W],
			        ALLSELECTED ( Fato_Solda[Data] ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			VAR _b0 =
			    CALCULATE (
			        [β0 Splash W],
			        ALLSELECTED ( Fato_Solda[Data] ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			VAR _ini =
			    CALCULATE (
			        [Data Início Regressão S],
			        ALLSELECTED ( Fato_Solda[Data] ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			VAR _fim =
			    CALCULATE (
			        [Data Fim Regressão W],
			        ALLSELECTED ( Fato_Solda[Data] ),
			        REMOVEFILTERS ( Fato_Solda[timerName] ),
			        Fato_Solda[timerName] = _robo
			    )
			RETURN
			    IF ( NOT ISBLANK ( _b ) && NOT ISBLANK ( _fim ) && NOT ISBLANK ( _ini ) && INT ( _dia ) >= INT ( _ini ),
			         ( _b0 + _b * ( INT ( _dia ) - INT ( _fim ) ) ) / 100 )
		formatString: 0.0%
		displayFolder: Criticidade x Splash
		lineageTag: 25ae30d6-aea9-49f7-b700-e06eb6bc13d5

	/// Robo que a tela 3.3 diagnostica: o selecionado no RANKING ou, sem selecao, o de maior % Splash entre os que tem nota.
	measure 'Robô em Foco' =
			VAR _sel = SELECTEDVALUE ( Fato_Solda[timerName] )
			VAR _top =
			    CALCULATE (
			        MAXX (
			            TOPN (
			                1,
			                FILTER (
			                    ADDCOLUMNS (
			                        ALLSELECTED ( Fato_Solda[timerName] ),
			                        "@lvl",
			                            CALCULATE (
			                                DIVIDE (
			                                    SUM ( Fato_Solda[count_Tem_Splash] ),
			                                    SUM ( Fato_Solda[row_count] )
			                                )
			                            ),
			                        "@sc", [Score Splash]
			                    ),
			                    NOT ISBLANK ( [@sc] )
			                ),
			                [@lvl], DESC,
			                Fato_Solda[timerName], ASC
			            ),
			            Fato_Solda[timerName]
			        )
			    )
			RETURN
			    COALESCE ( _sel, _top )
		displayFolder: Tela 3.3
		lineageTag: d6d4eada-0873-4705-8a5f-e45f78f0e8a9

	/// [R2 Splash] em percentual, para o cartao da 3.3 ler como "a reta explica N% da variacao diaria". Existe so pelo formato. Nao usar no Score: la o R2 entra como fracao.
	measure 'R² Explicado' = [R2 Splash]
		formatString: 0%
		displayFolder: Tela 3.3
		lineageTag: d7c62aa5-271c-4022-918a-ce4b5a4ddf9f

	/// Nota de risco de splash, 0 a 100, na MESMA estrutura do [Score] de pha2: aceleracao [β1 Splash_norm], nivel do dia [Δ BL|1D Splash], nivel do mes [Δ BL|1M Splash] e tendencia [β1 Splash], pesos 4/5/5/3 sobre 19, mais risco de explosao e risco estrutural com peso 1 cada. Baseline zero: ver [Δ BL|1D Splash]. Sem gate de elegibilidade -- todo robo recebe nota, inclusive os 150 sem nenhum evento de splash no historico e os de sensor desligado, que pontuam baixo por ausencia de dado e nao por saude comprovada.
	measure 'Score Splash' = ```
			
			        VAR _Med =
			            COALESCE(
			                CALCULATE(
			                    SUM( Fato_Solda[row_count] ),
			                    KEEPFILTERS( Fato_Solda[Status_Measuring] = "Ligado" )
			                ), 0 ) > 0
			        VAR _Limit_B1N  = 80.0
			        VAR _Limit_BL1D = 0.70
			        VAR _Limit_BL1M = 0.65
			        VAR _Limit_B1   = 40.0
			        VAR _Val_B1N  = COALESCE( [β1 splash_norm], 0 )
			        VAR _Val_BL1D = COALESCE( [Δ BL|1D splash], 0 )
			        VAR _Val_BL1M = COALESCE( [Δ BL|1M splash], 0 )
			        VAR _Val_B1   = COALESCE( [β1 splash], 0 )
			        VAR _Norm_B1N  = DIVIDE( IF(_Val_B1N <0,0,IF(_Val_B1N >_Limit_B1N, _Limit_B1N, _Val_B1N )), _Limit_B1N  )
			        VAR _Norm_BL1D = DIVIDE( IF(_Val_BL1D<0,0,IF(_Val_BL1D>_Limit_BL1D,_Limit_BL1D,_Val_BL1D)), _Limit_BL1D )
			        VAR _Norm_BL1M = DIVIDE( IF(_Val_BL1M<0,0,IF(_Val_BL1M>_Limit_BL1M,_Limit_BL1M,_Val_BL1M)), _Limit_BL1M )
			        VAR _Norm_B1   = DIVIDE( IF(_Val_B1  <0,0,IF(_Val_B1  >_Limit_B1,  _Limit_B1,  _Val_B1  )), _Limit_B1   )
			        VAR _T = 28
			        VAR _Score =
			              ( _Norm_BL1D * DIVIDE( 15, _T ) )
			            + ( _Norm_B1N  * DIVIDE( 5, _T ) )
			            + ( _Norm_BL1M * DIVIDE( 3, _T ) )
			            + ( _Norm_B1   * DIVIDE( 2, _T ) )
			            + ( _Norm_BL1D * _Norm_B1N * DIVIDE( 2, _T ) )
			            + ( _Norm_BL1M * _Norm_B1  * DIVIDE( 1, _T ) )
			        RETURN
			            IF( NOT _Med, BLANK(), ROUND( _Score * 100, 1 ) )
			```
		formatString: 0.0
		lineageTag: 636e6341-2468-4600-ae9e-c3d62ce16c40

	/// Ultimo dia com solda e sensor de splash LIGADO. Vazio para quem nunca foi medido, que e o sinal correto. Ignora o filtro de data da pagina.
	measure 'Última Medição' =
			CALCULATE (
			    MAX ( Fato_Solda[Data] ),
			    REMOVEFILTERS ( Fato_Solda[Status_Measuring] ),
			    Fato_Solda[Status_Measuring] = "Ligado"
			)
		formatString: dd/mm/yyyy
		displayFolder: Tela 3.3
		lineageTag: e2a543aa-a7c5-4a6f-bba4-4ee2cca44797

	/// Salto do mes corrente contra o de dois meses atras, em fracao. ATENCAO: o mes corrente entra PARCIAL, o que favorece o mes em curso. Corrigir com EOMONTH (so meses fechados) se virar problema.
	measure 'Δ 2M|1M Splash' =
			VAR DataReferencia = MAX(Fato_Solda[dateTime])
			VAR DataDoisMesesAtras = EDATE(DataReferencia, -2)
			VAR MesAtual =
			    CALCULATE(
			        [% Splash (v2)],
			        MONTH(Fato_Solda[dateTime]) = MONTH(DataReferencia),
			        YEAR(Fato_Solda[dateTime]) = YEAR(DataReferencia)
			    )
			VAR Mes2Atras =
			    CALCULATE(
			        [% Splash (v2)],
			        MONTH(Fato_Solda[dateTime]) = MONTH(DataDoisMesesAtras),
			        YEAR(Fato_Solda[dateTime]) = YEAR(DataDoisMesesAtras)
			    )
			RETURN
			    DIVIDE(MesAtual - Mes2Atras, Mes2Atras)
		lineageTag: e72305c8-0485-4ed4-96a0-cf9a981391c6

	/// Salto do ultimo dia contra a media dos 30 anteriores, em fracao. Positivo = piorou. Denominador quase zero explode a razao; quem barra isso e Min_Base_Delta, aplicado por quem consome.
	measure 'Δ 30D|1D Splash' =
			VAR MaxData = MAX(Fato_Solda[dateTime])
			VAR ValorUltimaData =
			    CALCULATE([% Splash (v2)], Fato_Solda[dateTime] = MaxData)
			VAR DataInicial = MaxData - 30
			VAR Media30DiasAntes =
			    CALCULATE(
			        [% Splash (v2)],
			        Fato_Solda[dateTime] >= DataInicial,
			        Fato_Solda[dateTime] < MaxData
			    )
			RETURN
			    DIVIDE(ValorUltimaData - Media30DiasAntes, Media30DiasAntes)
		lineageTag: 41379998-c6e8-49fd-83cb-e1df24b9150f

	/// Intercepto da regressao de [Beta], em pontos percentuais. Le a janela do MESMO parametro [Janela_Beta]: a reta da 3.3 usa a inclinacao de [Beta] com o intercepto daqui, e janelas diferentes fazem a reta sair da nuvem sem dar erro nenhum.
	measure 'β0 Splash' =
			VAR _MinDias = 7.0
			VAR _JanelaParam = 180.0
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			
			-- Exclui apagao de medicao (volume alto com zero splash = sensor desligado).
			VAR _Base = FILTER ( _Dias, NOT ( [@s] = 0 && [@n] >= 500 ) )
			VAR _xmin = MINX ( _Base, INT ( Fato_Solda[Data] ) )
			VAR _T =
			    ADDCOLUMNS (
			        _Base,
			        "@x", INT ( Fato_Solda[Data] ) - _xmin + 0.0,
			        "@y", DIVIDE ( [@s], [@n] ) * 100.0,
			        "@w", [@n] + 0.0
			    )
			
			VAR _n   = COUNTROWS ( _T )
			VAR _W   = SUMX ( _T, [@w] )
			VAR _Mx  = DIVIDE ( SUMX ( _T, [@w] * [@x] ), _W )
			VAR _My  = DIVIDE ( SUMX ( _T, [@w] * [@y] ), _W )
			VAR _Cov = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@y] - _My ) )
			VAR _Var = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@x] - _Mx ) )
			
			RETURN
			    IF (
			        _n < _MinDias || _Var = 0 || _W = 0,
			        BLANK (),
			        _My - DIVIDE ( _Cov, _Var ) * _Mx
			    )
		displayFolder: Criticidade x Splash
		lineageTag: 4f3875b3-fd3e-4819-92d1-ef0ffdee059b

	/// Intercepto da regressao ponderada de [Beta W], em pontos percentuais. Mesma janela e mesma meia-vida de [Beta W].
	measure 'β0 Splash W' =
			VAR _Lambda = DIVIDE( LN ( 2 ), 10.0 )
			VAR _MinDias = 7.0
			VAR _JanelaParam = 180.0
			VAR _Janela = IF ( _JanelaParam <= 0, 20000, _JanelaParam )
			VAR _MaxPinca =
			    MAX ( Fato_Solda[Data] )
			
			VAR _Dias =
			    CALCULATETABLE (
			        SUMMARIZE (
			            Fato_Solda,
			            Fato_Solda[Data],
			            "@n", SUM ( Fato_Solda[row_count] ),
			            "@s", SUM ( Fato_Solda[count_Tem_Splash] )
			        ),
			        			        KEEPFILTERS ( Fato_Solda[Data] > _MaxPinca - _Janela )
			    )
			
			-- Exclui apagao de medicao (volume alto com zero splash = sensor desligado).
			VAR _Base = FILTER ( _Dias, NOT ( [@s] = 0 && [@n] >= 500 ) )
			VAR _xmax = MAXX ( _Base, INT ( Fato_Solda[Data] ) )
			VAR _T =
			    ADDCOLUMNS (
			        _Base,
			        "@x", INT ( Fato_Solda[Data] ) - _xmax + 0.0,
			        "@y", DIVIDE ( [@s], [@n] ) * 100.0,
			        "@w",
			            VAR _atraso   = _xmax - INT ( Fato_Solda[Data] )
			            VAR _expoente = - _Lambda * _atraso
			            VAR _expSeguro = MAX ( MIN ( _expoente, 500 ), -500 )
			            RETURN ( [@n] + 0.0 ) * EXP ( _expSeguro )
			    )
			
			VAR _n   = COUNTROWS ( _T )
			VAR _W   = SUMX ( _T, [@w] )
			VAR _Mx  = DIVIDE ( SUMX ( _T, [@w] * [@x] ), _W )
			VAR _My  = DIVIDE ( SUMX ( _T, [@w] * [@y] ), _W )
			VAR _Cov = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@y] - _My ) )
			VAR _Var = SUMX ( _T, [@w] * ( [@x] - _Mx ) * ( [@x] - _Mx ) )
			
			RETURN
			    IF (
			        _n < _MinDias || _Var = 0 || _W = 0,
			        BLANK (),
			        _My - DIVIDE ( _Cov, _Var ) * _Mx
			    )
		displayFolder: Criticidade x Splash
		lineageTag: 84d8c9ce-ef18-4c4e-9f9c-8ed9ce418cd5

	/// [Beta] em pontos percentuais por 30 dias. So conversao de unidade.
	measure 'β1 Splash pp30' =
			VAR _B = [Beta]
			RETURN
			    IF ( NOT ISBLANK ( _B ), _B * 30.0 )
		formatString: 0.00
		lineageTag: adfe658a-1c61-4247-85e5-6fae51a0303d

	/// [Beta W] em pontos percentuais por 30 dias. So conversao de unidade.
	measure 'β1 Splash pp30 rec' =
