	column StatusDADOS = ```
			
			VAR CurrentTimerName = Fato_Solda[timerName]
			
			VAR LatestTimeSlot =
			    CALCULATE(
			        MAX(Fato_Solda[dateTime]),
			        FILTER(
			            ALL(Fato_Solda),
			            Fato_Solda[timerName] = CurrentTimerName
			        )
			    )
			
			VAR GlobalLatestDate = CALCULATE(MAX(Fato_Solda[dateTime]), ALL(Fato_Solda))
			
			// Compara se o número da semana do ano e o ano são os mesmos
			RETURN
			    IF(
			        WEEKNUM(LatestTimeSlot, 2) = WEEKNUM(GlobalLatestDate, 2) && 
			        YEAR(LatestTimeSlot) = YEAR(GlobalLatestDate),
			        "Updated",
			        "Outdated"
			    )
			```
		lineageTag: 4a7941b6-e0d6-41d2-b7d7-56145d85b071
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column X_Eixo = ```
			
			DATEDIFF(
			    CALCULATE(
			        MIN('Fato_Solda'[dateTime]),
			        ALLEXCEPT('Fato_Solda', 'Fato_Solda'[timerName])
			    ),
			    'Fato_Solda'[dateTime],
			    DAY
			)
			
			```
		formatString: 0
		lineageTag: 1262ca92-0b46-47e9-9144-08b54786c9f2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'β0_pha2_norm col' =
			
			VAR CurrTimer = SELECTEDVALUE('Fato_Solda'[timerName])
			
			-- Base filtrada pela segmentação
			VAR BaseFiltrada =
			    FILTER(
			        'Fato_Solda',
			        'Fato_Solda'[timerName] = CurrTimer &&
			        'Fato_Solda'[Data] IN VALUES(Dim_Data[Data])
			    )
			
			-- Cálculo de mínimos e máximos
			VAR MinimoX = CALCULATE(MIN('Fato_Solda'[X_Eixo]), BaseFiltrada)
			VAR MaximoX = CALCULATE(MAX('Fato_Solda'[X_Eixo]), BaseFiltrada)
			VAR MinimoY = CALCULATE(MIN('Fato_Solda'[pha2]), BaseFiltrada)
			VAR MaximoY = CALCULATE(MAX('Fato_Solda'[pha2]), BaseFiltrada)
			
			-- Normalização dos dados
			VAR TabelaNormalizada =
			    ADDCOLUMNS(
			        BaseFiltrada,
			        "NormX", DIVIDE('Fato_Solda'[X_Eixo] - MinimoX, MaximoX - MinimoX),
			        "NormY", DIVIDE('Fato_Solda'[pha2] - MinimoY, MaximoY - MinimoY)
			    )
			
			-- Médias dos dados normalizados
			VAR MediaNormX = AVERAGEX(TabelaNormalizada, [NormX])
			VAR MediaNormY = AVERAGEX(TabelaNormalizada, [NormY])
			
			-- Cálculo de beta1 (coeficiente angular)
			VAR TabelaDif =
			    ADDCOLUMNS(
			        TabelaNormalizada,
			        "DifX", [NormX] - MediaNormX,
			        "DifY", [NormY] - MediaNormY
			    )
			VAR CovXY = SUMX(TabelaDif, [DifX] * [DifY])
			VAR VariX = SUMX(TabelaDif, [DifX] * [DifX])
			VAR Beta1 = IF(VariX = 0, BLANK(), CovXY / VariX)
			
			-- Intercepto normalizado
			VAR Beta0 = MediaNormY - Beta1 * MediaNormX
			
			RETURN
			    Beta0
		lineageTag: 6c504511-7b8d-4ec4-8d2d-0bcd6a0fc168
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'β1 pha2_norm Col' =
			
			VAR CurrTimer = SELECTEDVALUE('Fato_Solda'[timerName])
			
			-- Filtra conforme contexto atual (sem ALL)
			VAR BaseFiltrada =
			    FILTER(
			        'Fato_Solda',
			        'Fato_Solda'[timerName] = CurrTimer &&
			        'Fato_Solda'[Data] IN VALUES(Dim_Data[Data])
			    )
			
			-- Define data final para cálculo de peso
			VAR UltimaData = MAXX(BaseFiltrada, 'Fato_Solda'[Data])
			
			-- Normalização de X_Eixo
			VAR MinimoX = MINX(BaseFiltrada, 'Fato_Solda'[X_Eixo])
			VAR MaximoX = MAXX(BaseFiltrada, 'Fato_Solda'[X_Eixo])
			VAR IntervaloX = MaximoX - MinimoX
			
			-- Normalização de pha2
			VAR MinimoY = MINX(BaseFiltrada, 'Fato_Solda'[pha2])
			VAR MaximoY = MAXX(BaseFiltrada, 'Fato_Solda'[pha2])
			VAR IntervaloY = MaximoY - MinimoY
			
			-- Tabela com pesos e dados normalizados
			VAR TabelaComPeso =
			    ADDCOLUMNS(
			        BaseFiltrada,
			        "Peso", EXP(-0.2 * DATEDIFF('Fato_Solda'[Data], UltimaData, DAY)),
			        "Xn", DIVIDE('Fato_Solda'[X_Eixo] - MinimoX, IntervaloX),
			        "Yn", DIVIDE('Fato_Solda'[pha2] - MinimoY, IntervaloY)
			    )
			
			-- Médias ponderadas
			VAR SomaPeso = SUMX(TabelaComPeso, [Peso])
			VAR MediaX = SUMX(TabelaComPeso, [Xn] * [Peso]) / SomaPeso
			VAR MediaY = SUMX(TabelaComPeso, [Yn] * [Peso]) / SomaPeso
			
			-- Diferenças e cálculo da covariância/variância ponderadas
			VAR TabelaDif =
			    ADDCOLUMNS(
			        TabelaComPeso,
			        "DifX", [Xn] - MediaX,
			        "DifY", [Yn] - MediaY
			    )
			
			VAR CovXY = SUMX(TabelaDif, [Peso] * [DifX] * [DifY])
			VAR VariX = SUMX(TabelaDif, [Peso] * [DifX] * [DifX])
			
			-- Inclinação e ângulo
			VAR Beta = IF(VariX = 0, BLANK(), CovXY / VariX)
			VAR Angulo = DEGREES(ATAN(Beta))
			
			RETURN
			    Beta
		lineageTag: 92c1c687-c22a-4837-99f1-69b1c211e13f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

