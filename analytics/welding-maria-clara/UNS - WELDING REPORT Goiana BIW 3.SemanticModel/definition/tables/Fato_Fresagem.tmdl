	partition Fato_Fresagem = m
		mode: import
		source = ```
				let
				    SqlString = "
				        WITH RawData AS (
				            SELECT 
				                REGEXP_EXTRACT(Topic, r'^(?:[^/]+/){4}([^/]+)') AS Line, 
				                REPLACE(JSON_EXTRACT_SCALAR(Payload, '$.timerName'), 'WB', 'R') AS timerName,
				                JSON_EXTRACT_SCALAR(Payload, '$.subIndex') AS subindex,
				                JSON_EXTRACT_SCALAR(Payload, '$.param_ID') AS param_ID,
				                JSON_EXTRACT_SCALAR(Payload, '$.value') AS value,
				                
				                -- Extraindo o timestamp do JSON, convertendo para número e depois para TIMESTAMP real
				                TIMESTAMP_MILLIS(CAST(JSON_EXTRACT_SCALAR(Payload, '$._timestamp') AS INT64)) AS _timestamp
				                
				            FROM 
				                `data-lake-manufacturing.Analytics_emille.vw_rawpubsubdata`
				            WHERE 
				                TIMESTAMP >= TIMESTAMP(DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH))
				                AND Topic LIKE '%DataProducts%ExtParamValues%'
				        ),
				        LatestData AS (
				            SELECT *
				            FROM RawData
				            QUALIFY ROW_NUMBER() OVER (
				                PARTITION BY timerName, subindex, param_ID 
				                ORDER BY _timestamp DESC -- Agora garantimos que pega o registro mais recente!
				            ) = 1
				        )
				        SELECT
				            Line,
				            timerName,
				            subindex,
				            MAX(_timestamp) AS _timestamp, -- Traz a data/hora mais recente da combinação
				            
				            MAX(CASE WHEN param_ID = '90' THEN value END) AS pontos_entre_fresas,
				            MAX(CASE WHEN param_ID = '91' THEN value END) AS quant_fresagem,
				            
				            CAST(MAX(CASE WHEN param_ID = '90' THEN value END) AS FLOAT64) * 
				            CAST(MAX(CASE WHEN param_ID = '91' THEN value END) AS FLOAT64) AS vida_eletrodo
				            
				        FROM LatestData
				        GROUP BY 
				            Line, 
				            timerName, 
				            subindex
				    ",
				    // 1. Conecta ao banco do Google BigQuery
				    BQ = GoogleBigQuery.Database(),
				    
				    // 2. Seleciona o Projeto onde a query será executada
				    Projeto = BQ{[Name="data-lake-manufacturing"]}[Data],
				    
				    // 3. Executa a string SQL diretamente no projeto
				    Fonte = Value.NativeQuery(Projeto, SqlString, null, [EnableFolding=true]),
				
				    // 4. Mantém a etapa de filtragem que você adicionou
				    #"Linhas filtradas" = Table.SelectRows(Fonte, each ([pontos_entre_fresas] <> null and [pontos_entre_fresas] <> "0"))
				in
				    #"Linhas filtradas"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

