	partition Fato_MudancaParam = m
		mode: import
		source = ```
				let
				    SqlString = "
				        SELECT
				            JSON_VALUE(payload, '$.protRecord_ID')      AS protRecord_ID,
				            JSON_VALUE(payload, '$.dateTime')           AS dateTime,
				            JSON_VALUE(payload, '$.timerName')          AS timerName,
				            JSON_VALUE(payload, '$.param_ID')           AS param_ID,
				            JSON_VALUE(payload, '$.param_status_txt')   AS param_status_txt, -- Coluna sem alteração
				            JSON_VALUE(payload, '$.subIndex')           AS subIndex,
				            JSON_VALUE(payload, '$.oldValue')           AS oldValue,
				            JSON_VALUE(payload, '$.oldValue_txt')       AS oldValue_txt,
				            JSON_VALUE(payload, '$.newValue')           AS newValue,
				            JSON_VALUE(payload, '$.newValue_txt')       AS newValue_txt,
				            JSON_VALUE(payload, '$.oldNormValue')       AS oldNormValue,
				            JSON_VALUE(payload, '$.newNormValue')       AS newNormValue,
				            JSON_VALUE(payload, '$.physicalUnitId')     AS physicalUnitId,
				            JSON_VALUE(payload, '$.physicalUnitId_txt') AS physicalUnitId_txt,
				            JSON_VALUE(payload, '$.computerName')       AS computerName,
				            JSON_VALUE(payload, '$.userName')           AS userName,
				            JSON_VALUE(payload, '$.comment')            AS comment
				        FROM
				            `data-lake-manufacturing.Analytics_emille.vw_rawpubsubdata`
				        WHERE
				            TIMESTAMP >= TIMESTAMP(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH))
				            AND Topic LIKE '%DataProducts%ExtDataChangeProt%'
				    ",
				    // 1. Conecta ao banco do Google BigQuery
				    BQ = GoogleBigQuery.Database(),
				    
				    // 2. Seleciona o Projeto onde a query será executada
				    Projeto = BQ{[Name="data-lake-manufacturing"]}[Data],
				    
				    // 3. Executa a string SQL diretamente no projeto
				    Fonte = Value.NativeQuery(Projeto, SqlString, null, [EnableFolding=true]),
				    #"Valor Substituído" = Table.ReplaceValue(Fonte,"presso","pressão",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído","1","1º",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Valor Substituído1","2","2º",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído3" = Table.ReplaceValue(#"Valor Substituído2","3","3º",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído4" = Table.ReplaceValue(#"Valor Substituído3","ps","pós",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído5" = Table.ReplaceValue(#"Valor Substituído4","Pr","Pré",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído6" = Table.ReplaceValue(#"Valor Substituído5","Mx","Máximo",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído7" = Table.ReplaceValue(#"Valor Substituído6","Medio","Medição",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído8" = Table.ReplaceValue(#"Valor Substituído7","N. ","Nº.",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído9" = Table.ReplaceValue(#"Valor Substituído8","Potncia","Potência",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído10" = Table.ReplaceValue(#"Valor Substituído9","Monitorao","Monitoração (S)",Replacer.ReplaceText,{"param_status_txt"}),
				    #"Valor Substituído11" = Table.ReplaceValue(#"Valor Substituído10","rio","ário",Replacer.ReplaceText,{"oldValue_txt"}),
				    #"Tipo Alterado" = Table.ReplaceValue(#"Valor Substituído11","rio", "ário",Replacer.ReplaceText,{"newValue_txt"}),
				    #"Tipo Fuso Horario" = Table.TransformColumnTypes(#"Tipo Alterado",{{"dateTime", type datetimezone}}),
				    #"Coluna Duplicada" = Table.DuplicateColumn(#"Tipo Fuso Horario", "dateTime", "Data"),
				    #"Tipo Data Final" = Table.TransformColumnTypes(#"Coluna Duplicada",{{"Data", type date}}),
				  #"Linhas classificadas" = Table.Sort(#"Tipo Data Final", {{"dateTime", Order.Descending}})
				in
				    #"Linhas classificadas"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

