	column 'Status Old' = ```
			
			VAR ThistimerName =
			    Fato_MudancaParam[timerName]
			
			VAR LatestTimeSlot =
			    CALCULATE(
			        MAX(Fato_MudancaParam[dateTime]),
			        Fato_MudancaParam[timerName] = ThistimerName, all(Fato_MudancaParam)
			    )
			VAR Status_Desligada =
			    LOOKUPVALUE(
			        Fato_MudancaParam[dateTime],
			        Fato_MudancaParam[oldValue_txt], "Deslig",
			        Fato_MudancaParam[dateTime], LatestTimeSlot, 
			        Fato_MudancaParam[timerName], ThistimerName
			    )
			
			    
			VAR Status_Ligado =
			    LOOKUPVALUE(
			        Fato_MudancaParam[oldValue_txt],
			        Fato_MudancaParam[dateTime], LatestTimeSlot,
			        Fato_MudancaParam[timerName], ThistimerName,
			        Fato_MudancaParam[oldValue_txt], "Ligado"
			    )
			
			VAR Status_Final = 
			    IF(NOT ISBLANK(Status_Desligada), "Desligada",
			        IF(NOT ISBLANK(Status_Ligado), "Ligada", "Desconhecida")
			    )
			
			RETURN
			    Status_Final
			
			
			
			```
		lineageTag: ed3ab39c-6c5d-47d7-ad6f-e9f0f4faa787
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Status New' = ```
			
			VAR ThistimerName =
			    Fato_MudancaParam[timerName]
			
			VAR LatestTimeSlot =
			    CALCULATE(
			        MAX(Fato_MudancaParam[dateTime]),
			        Fato_MudancaParam[timerName] = ThistimerName, all(Fato_MudancaParam)
			    )
			VAR Status_Desligada =
			    LOOKUPVALUE(
			        Fato_MudancaParam[dateTime],
			        Fato_MudancaParam[newValue_txt], "Deslig",
			        Fato_MudancaParam[dateTime], LatestTimeSlot, 
			        Fato_MudancaParam[timerName], ThistimerName
			    )
			
			    
			VAR Status_Ligado =
			    LOOKUPVALUE(
			        Fato_MudancaParam[newValue_txt],
			        Fato_MudancaParam[dateTime], LatestTimeSlot,
			        Fato_MudancaParam[timerName], ThistimerName,
			        Fato_MudancaParam[newValue_txt], "Ligado"
			    )
			
			VAR Status_Final = 
			    IF(NOT ISBLANK(Status_Desligada), "Desligada",
			        IF(NOT ISBLANK(Status_Ligado), "Ligada", "Desconhecida")
			    )
			
			RETURN
			    Status_Final
			
			
			
			```
		lineageTag: 0e086376-9827-44cb-9cba-44a93451a2c2
