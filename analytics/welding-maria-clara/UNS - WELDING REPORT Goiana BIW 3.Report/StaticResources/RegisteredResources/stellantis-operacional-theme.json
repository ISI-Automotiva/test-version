            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F6F8"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "show": true
          },
          {
            "$id": "default",
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#F5F6F8"
              }
            }
          },
          {
            "$id": "pressed",
            "fillColor": {
              "solid": {
                "color": "#FCEAE3"
              }
            }
          }
        ],
        "icon": [
          {
            "show": true
          },
          {
            "$id": "default",
            "lineColor": {
              "solid": {
                "color": "#282B34"
              }
            }
          },
          {
            "$id": "hover",
            "lineColor": {
              "solid": {
                "color": "#E94E24"
              }
            }
          },
          {
            "$id": "pressed",
            "lineColor": {
              "solid": {
                "color": "#E94E24"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#C7CBD1"
