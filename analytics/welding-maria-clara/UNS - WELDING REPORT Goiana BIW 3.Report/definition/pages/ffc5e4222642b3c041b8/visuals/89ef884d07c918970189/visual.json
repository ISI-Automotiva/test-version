            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Score de risco: metade do peso é o nível de splash, metade é a piora (tendência, aceleração e dois saltos). Beta e Beta W são as próprias entradas de tendência do Score — Beta W pondera os dias recentes, Beta pesa os 60 dias, então Beta W bem maior indica piora concentrada. Valores em pontos percentuais por dia. Compare robô com robô: a nota usa a parte baixa da escala e o pior do parque hoje está em 49.'"
                }
              }
            },
